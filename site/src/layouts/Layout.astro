---
interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title} | DrawryDB</title>
  </head>
  <body>
    <div class="disclaimer">
      非公式のファンサイトです — Drawry.
      本人・関係者・公式とは一切関係ありません。
      <a href="https://x.com/soreyoriramen" target="_blank" rel="noopener noreferrer">ramen</a>
      が個人的に作成・運営しています。
    </div>

    <header class="site-header">
      <a class="site-title" href={`${base}/ja/`}>DrawryDB</a>
      <nav>
        <a href={`${base}/ja/events/`}>イベント</a>
        <a href={`${base}/ja/songs/`}>楽曲</a>
        <a href={`${base}/ja/venues/`}>会場</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        This is an unofficial fan project, not affiliated with Drawry. or
        their management. Contact:
        <a href="https://x.com/soreyoriramen" target="_blank" rel="noopener noreferrer">@soreyoriramen</a>
        (ramen).
      </p>
      <p>
        <a href="https://github.com/ganbaramen/drawrydb" target="_blank" rel="noopener noreferrer">Source on GitHub</a>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
