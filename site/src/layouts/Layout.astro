---
import '../styles/global.css';

import { Button } from '@/components/ui/button';
import { Icon } from '@/components/ui/icon';
import { Separator } from '@/components/ui/separator';
import { LOCALES, t, type Lang } from '../lib/i18n';

interface Props {
  title: string;
  lang: Lang;
  // This page's path relative to `/{lang}/` — "" for home, "events/",
  // "events/2026-08-17-1/", etc. — so the language switcher can link to
  // the same page in the other locale instead of always going home.
  path: string;
}

const { title, lang, path } = Astro.props;
const base = import.meta.env.BASE_URL;

// The home page passes the site's own name as its title, so appending the
// suffix unconditionally rendered "DrawryDB. | DrawryDB.".
const SITE_NAME = 'DrawryDB.';
const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;

const navLinks = [
  { href: 'events/', label: t(lang, 'nav.events') },
  { href: 'songs/', label: t(lang, 'nav.songs') },
  { href: 'venues/', label: t(lang, 'nav.venues') },
  { href: 'creators/', label: t(lang, 'nav.creators') },
  { href: 'set-lengths/', label: t(lang, 'nav.setLength') },
];
// Highlight the section the current page belongs to — `path` is already
// "events/…" for both the index and a detail page, so a prefix test covers
// both without each page having to declare its section separately.
const section = path.split('/')[0];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{fullTitle}</title>
    <script is:inline>
      // Runs synchronously, before first paint, so a stored preference
      // applies immediately instead of flashing the OS-default theme first.
      // No preference stored -> no attribute set -> global.css's
      // prefers-color-scheme media query decides, same as before this
      // toggle existed.
      // Reading can throw for the same reasons writing can; no stored choice
      // is the correct fallback either way, and it is what an exception here
      // produces anyway — but only if it does not take the rest of the script
      // with it.
      try {
        const stored = localStorage.getItem('theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.dataset.theme = stored;
        }
      } catch {}

      // Marks the document as scripted, before first paint and outside the
      // try above so a storage throw can't skip it. global.css hangs the
      // narrow-screen nav collapse off this: without it the section links
      // stay in normal flow and wrap to a second row, because the button
      // that would reveal them only works if this script ran. Setting it
      // pre-paint is what keeps a scripted visit from flashing the links
      // before they collapse.
      document.documentElement.dataset.js = '';
    </script>
  </head>
  <body class="min-h-dvh">
    <!--
      Every page opens with eight focusable controls before <main>, so a
      keyboard user traversed the whole header on every navigation. This is
      the first thing in the document and is visually hidden until focused.
    -->
    <a href="#main" class="skip-link">{t(lang, 'a11y.skipToContent')}</a>
    <header
      class="bg-background/85 supports-[backdrop-filter]:bg-background/70 sticky top-0 z-40 border-b backdrop-blur"
    >
      <div class="relative mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-y-2 px-4 py-3">
        <a
          href={`${base}/${lang}/`}
          class="text-foreground hover:text-primary text-lg font-bold tracking-tight transition-colors"
        >
          DrawryDB.
        </a>

        <div class="flex flex-wrap items-center justify-end gap-x-3 gap-y-2">
          <!--
            A plain inline row in the markup, at every width. The dropdown
            behaviour below the `sm` breakpoint is added by global.css and
            only when <html> carries data-js, because the button that opens
            it needs script: hiding the links unconditionally left them
            unreachable without JavaScript, with a visible, focusable, inert
            button as the only route to them. Still driven by data-open
            rather than a class, so the script stays one attribute flip.
          -->
          <nav
            id="site-nav"
            data-open="false"
            class="flex flex-wrap items-center justify-end gap-0.5"
          >
            {
              navLinks.map((link) => (
                <Button
                  as="a"
                  href={`${base}/${lang}/${link.href}`}
                  variant="ghost"
                  size="sm"
                  class="max-sm:justify-start"
                  aria-current={section === link.href.slice(0, -1) ? 'page' : undefined}
                  data-active={section === link.href.slice(0, -1) ? '' : undefined}
                >
                  {link.label}
                </Button>
              ))
            }
          </nav>

          <div class="flex items-center gap-2">
            <!--
              The pair is a labelled group, not two loose letters: without a
              name the link is announced as a bare "EN" with nothing saying
              it changes the site's language. `lang`/`hreflang` mark the link
              as pointing at the other language so it isn't pronounced with
              this page's rules. Both halves are padded to a real pointer
              target — they used to be the bare 16px glyphs, 4px apart.
            -->
            <span
              class="text-muted-foreground inline-flex items-center text-xs"
              role="group"
              aria-label={t(lang, 'nav.language')}
            >
              {
                LOCALES.map((l) =>
                  l === lang ? (
                    <span
                      class="text-foreground inline-flex min-h-6 min-w-6 items-center justify-center px-1 font-semibold"
                      aria-current="true"
                    >
                      {l.toUpperCase()}
                    </span>
                  ) : (
                    <a
                      href={`${base}/${l}/${path}`}
                      lang={l}
                      hreflang={l}
                      class="hover:text-foreground focus-visible:ring-ring/50 inline-flex min-h-6 min-w-6 items-center justify-center rounded px-1 transition-colors outline-none focus-visible:ring-[3px]"
                    >
                      {l.toUpperCase()}
                    </a>
                  ),
                )
              }
            </span>
            <Button
              id="theme-toggle"
              type="button"
              variant="outline"
              size="icon-sm"
              aria-label={t(lang, 'theme.toggle')}
              data-announce-light={t(lang, 'theme.announce.light')}
              data-announce-dark={t(lang, 'theme.announce.dark')}
            >
              <Icon name="moon" data-icon-moon />
              <Icon name="sun" data-icon-sun class="hidden size-[1em] text-base" />
            </Button>
            <!--
              What confirms the click. The button carries no aria-pressed:
              it has three states (light, dark, following the OS) where
              aria-pressed has two, and its label describes the theme the
              *next* click gives rather than the current one, so a "pressed"
              state on it would be answering a different question. The
              palette change is the confirmation for everyone who can see
              it; this region is that confirmation for everyone else.

              Same shape as the events index's #event-announce, and for the
              same reason: it ships empty and is written to, which is the
              pattern VoiceOver actually honours. Placed outside the button
              so writing to it never disturbs the button's own name.
            -->
            <p id="theme-announce" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
            <!--
              No `sm:hidden` here: global.css hides it at every width unless
              <html> has data-js. A button that cannot do anything should not
              be in the tab order at all, which is what it was without
              script.
            -->
            <Button
              id="nav-toggle"
              type="button"
              variant="outline"
              size="icon-sm"
              aria-label={t(lang, 'nav.toggle')}
              aria-expanded="false"
              aria-controls="site-nav"
            >
              <Icon name="menu" />
            </Button>
          </div>
        </div>
      </div>
    </header>

    <!--
      tabindex="-1" so the skip link actually moves focus here rather than
      only the scroll position: a <main> is not focusable on its own, and
      browsers differ on whether a fragment link resets the focus point.
      Negative, so it never joins the tab order itself.
    -->
    <main
      id="main"
      tabindex="-1"
      class="mx-auto flex w-full max-w-3xl flex-col gap-6 px-4 pt-8 pb-16 outline-none"
    >
      <slot />
    </main>

    <footer class="mx-auto w-full max-w-3xl px-4 pb-8">
      <Separator class="mb-4" />
      <div class="text-muted-foreground space-y-2 text-sm">
        <p>
          {t(lang, 'footer.disclaimer')}
          <br />
          {t(lang, 'footer.contact')}<a
            class="hover:text-foreground underline underline-offset-4 transition-colors"
            href="https://x.com/soreyoriramen"
            target="_blank"
            rel="noopener noreferrer">ramen (@soreyoriramen)</a
          >
        </p>
        <p>
          <a
            class="hover:text-foreground inline-flex items-center gap-1.5 underline underline-offset-4 transition-colors"
            href="https://github.com/ganbaramen/drawrydb"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="github" class="size-3.5" />
            {t(lang, 'footer.source')}
          </a>
        </p>
      </div>
    </footer>

    <script>
      import { initTableScrollShadows } from '../lib/table-scroll';
      // No-op on a page with no scrollable table.
      initTableScrollShadows();
    </script>

    <script>
      // Only meaningful on the narrow viewports where the nav's max-sm:
      // classes actually turn it into a hidden dropdown — harmless no-op
      // (button stays display:none) above that breakpoint.
      const navToggle = document.getElementById('nav-toggle')!;
      const siteNav = document.getElementById('site-nav')!;

      function closeNav() {
        siteNav.dataset.open = 'false';
        navToggle.setAttribute('aria-expanded', 'false');
      }

      navToggle.addEventListener('click', () => {
        const open = siteNav.dataset.open === 'true';
        siteNav.dataset.open = open ? 'false' : 'true';
        navToggle.setAttribute('aria-expanded', open ? 'false' : 'true');
        // Move into the panel on open. The five links sit *before* this
        // button in the document, so without this a keyboard user's next
        // Tab leaves the header entirely and the panel they just opened is
        // only reachable backwards, past two other controls.
        if (!open) siteNav.querySelector<HTMLElement>('a')?.focus();
      });

      // Clicking a link navigates away anyway, but closing first avoids a
      // stale "open" dropdown flashing on the next page's initial paint —
      // Astro's static pages don't preserve script state across a
      // navigation, so this only matters for the instant before unload.
      siteNav.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) closeNav();
      });

      document.addEventListener('click', (e) => {
        const target = e.target as Node;
        if (siteNav.dataset.open === 'true' && !siteNav.contains(target) && !navToggle.contains(target)) {
          closeNav();
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && siteNav.dataset.open === 'true') {
          // Focus is inside the panel we are about to hide, so hand it back
          // to the control that opened it rather than letting it fall to
          // the document.
          const inside = siteNav.contains(document.activeElement);
          closeNav();
          if (inside) navToggle.focus();
        }
      });

      const root = document.documentElement;
      const button = document.getElementById('theme-toggle')!;
      const media = window.matchMedia('(prefers-color-scheme: dark)');
      // Both icons ship in the markup (lucide SVGs are inlined at build
      // time by the Icon component, so there's nothing to swap a `name`
      // for at runtime); syncIcon just picks which one is visible.
      const moonIcon = button.querySelector('[data-icon-moon]') as SVGElement;
      const sunIcon = button.querySelector('[data-icon-sun]') as SVGElement;

      function effectiveTheme(): 'light' | 'dark' {
        return (root.dataset.theme as 'light' | 'dark' | undefined) ?? (media.matches ? 'dark' : 'light');
      }

      // Icon shows what clicking it switches *to*, not the current state.
      function syncIcon() {
        const dark = effectiveTheme() === 'dark';
        moonIcon.classList.toggle('hidden', dark);
        sunIcon.classList.toggle('hidden', !dark);
      }

      // The button's accessible name is identical before and after a click,
      // so nothing about the button confirms it did anything. Announce the
      // theme that is now in force instead.
      //
      // Clearing before the write is what makes a repeat announcement
      // register at all: writing the same string a region already holds is
      // swallowed as "no new content", which a visitor toggling back and
      // forth past an OS change would hit. The 100ms gap is the same one
      // the events index needs — a clear and a write in one frame collapse
      // into no change having happened.
      const announceEl = document.getElementById('theme-announce')!;
      let announceTimer: number | undefined;
      function announceTheme(theme: 'light' | 'dark') {
        const text =
          theme === 'dark' ? button.dataset.announceDark! : button.dataset.announceLight!;
        window.clearTimeout(announceTimer);
        announceEl.textContent = '';
        announceTimer = window.setTimeout(() => {
          announceEl.textContent = text;
        }, 100);
      }

      button.addEventListener('click', () => {
        const next = effectiveTheme() === 'dark' ? 'light' : 'dark';
        // Repaint the page through the View Transitions API: the new theme
        // is revealed by a rectangle sweeping up from the bottom edge.
        // Browsers without the API, and reduced-motion users, get the
        // instant switch we always had.
        const apply = () => {
          root.dataset.theme = next;
          // Icon before the write: storing can throw (site data blocked, quota
          // exhausted) and the palette has already changed by then, so syncing
          // afterwards left the button showing the old state on a page that
          // had already switched. Wrapped too, so a failed write costs the
          // preference and nothing else.
          syncIcon();
          // Before the write, for the same reason the icon sync is: storing
          // can throw, and the palette has already changed by the time it
          // does. A failed write costs the preference and nothing else.
          announceTheme(next);
          try {
            localStorage.setItem('theme', next);
          } catch {}
        };
        if (
          !document.startViewTransition ||
          window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          apply();
          return;
        }
        const transition = document.startViewTransition(apply);
        // ready rejects only if the transition gets skipped (e.g. a second
        // toggle before this one starts animating) — nothing to animate then.
        transition.ready
          .then(() => {
            // Default UA animation would cross-fade; disable it so only our
            // clip-path on the new snapshot runs. The old snapshot stays
            // painted underneath until the reveal covers it.
            root.animate(
              { clipPath: ['inset(100% 0 0 0)', 'inset(0 0 0 0)'] },
              { duration: 450, easing: 'ease-in-out', pseudoElement: '::view-transition-new(root)' },
            );
          })
          .catch(() => {});
      });

      // No stored preference means the OS setting still governs — keep the
      // icon in sync if the visitor changes it while the page is open.
      media.addEventListener('change', () => {
        // Deliberately silent: this is the OS changing under a page the
        // visitor may not be looking at, not something they did here. The
        // icon still has to keep up, but announcing it would speak at
        // someone who never touched this control.
        try {
          if (localStorage.getItem('theme')) return;
        } catch {
          // Storage blocked means no explicit preference can have been
          // stored, so the OS still governs — sync rather than bail.
        }
        syncIcon();
      });

      syncIcon();
    </script>
  </body>
</html>
