---
import { LOCALES, t, type Lang } from '../lib/i18n';

interface Props {
  title: string;
  lang: Lang;
  // This page's path relative to `/{lang}/` — "" for home, "events/",
  // "events/2026-08-17-1/", etc. — so the language switcher can link to
  // the same page in the other locale instead of always going home.
  path: string;
}

const { title, lang, path } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title} | DrawryDB.</title>
    <script is:inline>
      // Runs synchronously, before first paint, so a stored preference
      // applies immediately instead of flashing the OS-default theme first.
      // No preference stored -> no attribute set -> global.css's
      // prefers-color-scheme media query decides, same as before this
      // toggle existed.
      const stored = localStorage.getItem('theme');
      if (stored === 'light' || stored === 'dark') {
        document.documentElement.dataset.theme = stored;
      }
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href={`${base}/${lang}/`}>DrawryDB.</a>
      <div class="header-right">
        <nav class="site-nav" id="site-nav">
          <a href={`${base}/${lang}/events/`}>{t(lang, 'nav.events')}</a>
          <a href={`${base}/${lang}/songs/`}>{t(lang, 'nav.songs')}</a>
          <a href={`${base}/${lang}/venues/`}>{t(lang, 'nav.venues')}</a>
          <a href={`${base}/${lang}/set-lengths/`}>{t(lang, 'nav.setLength')}</a>
        </nav>
        <div class="header-controls">
          <span class="lang-switch">
            {
              LOCALES.map((l) =>
                l === lang ? (
                  <span class="lang-current" aria-current="true">
                    {l.toUpperCase()}
                  </span>
                ) : (
                  <a href={`${base}/${l}/${path}`}>{l.toUpperCase()}</a>
                ),
              )
            }
          </span>
          <button id="theme-toggle" class="theme-toggle" type="button" aria-label={t(lang, 'theme.toggle')}>
            🌙
          </button>
          <button
            id="nav-toggle"
            class="nav-toggle"
            type="button"
            aria-label={t(lang, 'nav.toggle')}
            aria-expanded="false"
            aria-controls="site-nav"
          >
            ☰
          </button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        {t(lang, 'footer.disclaimer')}
        <br />
        {t(lang, 'footer.contact')}<a
          href="https://x.com/soreyoriramen"
          target="_blank"
          rel="noopener noreferrer">ramen (@soreyoriramen)</a
        >
      </p>
      <p>
        <a href="https://github.com/ganbaramen/drawrydb" target="_blank" rel="noopener noreferrer">
          {t(lang, 'footer.source')}
        </a>
      </p>
    </footer>

    <script>
      import { initTableScrollShadows } from '../lib/table-scroll';
      // No-op on a page with no .table-scroll element.
      initTableScrollShadows();
    </script>

    <script>
      // Only meaningful on the narrow viewports where global.css's media
      // query actually turns .site-nav into a hidden dropdown — harmless
      // no-op (button stays display:none) above that breakpoint.
      const navToggle = document.getElementById('nav-toggle')!;
      const siteNav = document.getElementById('site-nav')!;

      function closeNav() {
        siteNav.dataset.open = 'false';
        navToggle.setAttribute('aria-expanded', 'false');
      }

      navToggle.addEventListener('click', () => {
        const open = siteNav.dataset.open === 'true';
        siteNav.dataset.open = open ? 'false' : 'true';
        navToggle.setAttribute('aria-expanded', open ? 'false' : 'true');
      });

      // Clicking a link navigates away anyway, but closing first avoids a
      // stale "open" dropdown flashing on the next page's initial paint —
      // Astro's static pages don't preserve script state across a
      // navigation, so this only matters for the instant before unload.
      siteNav.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).tagName === 'A') closeNav();
      });

      document.addEventListener('click', (e) => {
        const target = e.target as Node;
        if (siteNav.dataset.open === 'true' && !siteNav.contains(target) && !navToggle.contains(target)) {
          closeNav();
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && siteNav.dataset.open === 'true') closeNav();
      });

      const root = document.documentElement;
      const button = document.getElementById('theme-toggle')!;
      const media = window.matchMedia('(prefers-color-scheme: dark)');

      function effectiveTheme(): 'light' | 'dark' {
        return (root.dataset.theme as 'light' | 'dark' | undefined) ?? (media.matches ? 'dark' : 'light');
      }

      // Icon shows what clicking it switches *to*, not the current state.
      function syncIcon() {
        button.textContent = effectiveTheme() === 'dark' ? '☀️' : '🌙';
      }

      button.addEventListener('click', () => {
        const next = effectiveTheme() === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('theme', next);
        syncIcon();
      });

      // No stored preference means the OS setting still governs — keep the
      // icon in sync if the visitor changes it while the page is open.
      media.addEventListener('change', () => {
        if (!localStorage.getItem('theme')) syncIcon();
      });

      syncIcon();
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
