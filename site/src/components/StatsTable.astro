---
// Wrapper for the sortable stats tables (songs index, set lengths).
//
// Deliberately *bare*, which is how Fulldev presents a table: rows separated
// by their own bottom borders, no outer frame and no header fill, sitting
// directly on the page background. The only things added here are two
// corrections to how it meets this page:
//
//   - Column sizing. Fulldev's <Table> is w-full, which stretches whichever
//     column has the most slack (the song-name one) and leaves a gap
//     mid-row. w-auto/min-w-full sizes columns to their own content and
//     lets the container scroll once they outgrow the page, which is what
//     the pre-Fulldev stylesheet did.
//   - Edge alignment. The stock px-2 on cells would inset the first column
//     from the page's text column, so the table's left edge wouldn't line up
//     with the h1 above it. The outermost cell on each side loses its
//     padding instead.
//
// Fulldev's <Table> already renders its own overflow-x-auto container, so
// there's nothing to add for horizontal scrolling — lib/table-scroll.ts
// finds that container by data-slot="table-container" and hangs the edge
// shadows on it.
import { cn } from '@/lib/utils';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class={cn(
    '[&_table]:w-auto [&_table]:min-w-full',
    '[&_th:first-child]:pl-0 [&_td:first-child]:pl-0',
    '[&_th:last-child]:pr-0 [&_td:last-child]:pr-0',
    className,
  )}
>
  <slot />
</div>
