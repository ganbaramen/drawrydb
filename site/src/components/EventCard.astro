---
// One row in any of the site's event-ish lists: the home page's next/recent
// lives, the events index, a song's or venue's performance history, a set
// length's shows. Built on Fulldev's Item (which renders an <a> when given
// href), so all of those share one hover/focus treatment.
//
// Item's `default` size (px-4 py-3.5), not `sm`: these cards stack three
// lines of mostly-Japanese text, and sm's px-3 py-2.5 with a 2px inner gap
// read as cramped against the border.
//
// The .event-date / .event-title / .event-venue class hooks are load-bearing,
// not styling: the home page's inline script re-picks the next live on the
// visitor's clock and rewrites those three nodes' text. Keep them if this
// markup changes.
import { Item, ItemContent, ItemTitle } from '@/components/ui/item';
import { cn } from '@/lib/utils';

interface Props {
  href: string;
  title: string;
  date?: string;
  // Nullable, not just optional: site_data.json writes null for an event
  // with no venue and for a performance with no note.
  venue?: string | null;
  note?: string | null;
  // Render the venue line even when there is no venue, hidden. Only the home
  // page's next-live card needs this: its script re-picks the event in the
  // browser and may land on one that has a venue where the build-time pick
  // had none. Reserving the element means that script only ever sets text
  // and flips `hidden` — it never builds markup, so there is no copy of this
  // component's classes anywhere else to fall out of sync.
  reserveVenue?: boolean;
  id?: string;
  class?: string;
  [key: `data-${string}`]: string | undefined;
}

const { href, title, date, venue, note, reserveVenue, class: className, ...rest } = Astro.props;
---

<Item
  href={href}
  variant="outline"
  size="default"
  class={cn('bg-card hover:bg-card hover:border-primary/60 items-start gap-x-3', className)}
  {...rest}
>
  <ItemContent class="event-card-content gap-1">
    {date && <div class="event-date text-muted-foreground text-xs tabular-nums">{date}</div>}
    <!-- gap-x-4, not ItemTitle's own gap-2: the badge sits against a bold
         Japanese title whose glyphs run to the edge of their box with none
         of the side bearing a Latin word ends on, so the same measure reads
         tighter here. Worst case is a title ending in a CJK character
         ("...時間未定"); titles closing on 」 look roomier at any value, so
         tune against the former. Row gap stays small — it only applies when
         a long title wraps the badge onto its own line, where 16px would
         detach it from the title it belongs to. -->
    <ItemTitle class="line-clamp-none flex-wrap gap-x-4 gap-y-1.5 leading-normal font-semibold">
      <span class="event-title">{title}</span>
      <slot name="badge" />
    </ItemTitle>
    {(venue || reserveVenue) && (
      <div class="event-venue text-muted-foreground text-sm leading-normal" hidden={!venue}>
        {venue}
      </div>
    )}
    {note && <div class="text-muted-foreground text-xs leading-normal">{note}</div>}
    <slot />
  </ItemContent>
  <slot name="trailing" />
</Item>
