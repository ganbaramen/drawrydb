---
// One label/value pair inside <MetaTable>. The label column is a row-scoped
// <th> (it names the row, not a column), fixed narrow so values line up
// across rows; on a phone the labels would eat the row, so it shrinks.
import { TableCell, TableHead, TableRow } from '@/components/ui/table';

interface Props {
  label: string;
  /**
   * Keep the value's own line breaks instead of collapsing them. Off by
   * default because almost every value is a single phrase; the song page's
   * credits note is the exception, and a note holding two source URLs on
   * separate lines ran them together into one unreadable line without this.
   * Mirrors what `.event-note` does for event notes.
   */
  preLine?: boolean;
}

const { label, preLine = false } = Astro.props;
---

<TableRow>
  <TableHead
    scope="row"
    class="text-muted-foreground w-28 py-2 align-top text-xs font-medium whitespace-normal sm:w-36 sm:text-sm"
  >
    {label}
  </TableHead>
  <TableCell class:list={['align-top', preLine ? 'whitespace-pre-line' : 'whitespace-normal']}>
    <slot />
  </TableCell>
</TableRow>
