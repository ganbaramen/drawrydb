---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"div">

const { class: className, ...props } = Astro.props
---

<!--
  A real <ul>, not a <div role="list">. The stock component set role="list"
  on the container while its children stayed plain anchors with no listitem
  role — and a list with no list items conveys no length, so "1 of 143" was
  never announced. Item renders each child as an <li>.
-->
<ul
  data-slot="item-group"
  class={cn(
    "group/item-group flex w-full flex-col gap-4 has-data-[size=sm]:gap-2.5 has-data-[size=xs]:gap-2",
    className
  )}
  {...props}
>
  <slot />
</ul>
