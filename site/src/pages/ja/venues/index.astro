---
import Layout from '../../../layouts/Layout.astro';
import { venues } from '../../../lib/data';
import { urlSafe } from '../../../lib/format';

const base = import.meta.env.BASE_URL;
const sorted = venues.slice().sort((a, b) => b.shows - a.shows);
---

<Layout title="会場一覧">
  <h1>会場一覧</h1>
  <p>{venues.length}会場</p>
  <table class="stats-table">
    <thead>
      <tr>
        <th>会場</th>
        <th>公演回数</th>
        <th>初出演</th>
        <th>最終出演</th>
      </tr>
    </thead>
    <tbody>
      {
        sorted.map((venue) => (
          <tr>
            <td>
              <a href={`${base}/ja/venues/${urlSafe(venue.id)}/`}>{venue.name}</a>
            </td>
            <td>{venue.shows}</td>
            <td>{venue.first_played}</td>
            <td>{venue.last_played}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</Layout>
