---
import Layout from '../../layouts/Layout.astro';
import { upcomingEvents, recentSetlists } from '../../lib/data';
import { formatDateJa } from '../../lib/format';

const base = import.meta.env.BASE_URL;
const next = upcomingEvents(1)[0];
const recent = recentSetlists(5);
---

<Layout title="ホーム">
  <h1>DrawryDB</h1>
  <p>Drawry. のライブスケジュールとセットリストのデータベース。</p>

  {
    next && (
      <section>
        <h2>次のライブ</h2>
        <a class="event-card" href={`${base}/ja/events/${next.id}/`}>
          <div class="event-date">{formatDateJa(next.date)}</div>
          <div class="event-title">
            {next.title}
            {!next.has_setlist && <span class="badge-pending">セトリ未公開</span>}
          </div>
          {next.venue && <div class="event-venue">{next.venue}</div>}
        </a>
      </section>
    )
  }

  <section>
    <h2>最近のセットリスト</h2>
    <ul style="list-style:none; padding:0;">
      {
        recent.map((event) => (
          <li>
            <a class="event-card" href={`${base}/ja/events/${event.id}/`}>
              <div class="event-date">{formatDateJa(event.date)}</div>
              <div class="event-title">{event.title}</div>
              {event.venue && <div class="event-venue">{event.venue}</div>}
            </a>
          </li>
        ))
      }
    </ul>
    <p><a href={`${base}/ja/events/`}>すべてのイベントを見る →</a></p>
  </section>
</Layout>
