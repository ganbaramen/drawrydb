---
import Layout from '../../../layouts/Layout.astro';
import { setLengthStats, getEvent, type LengthBucket } from '../../../lib/data';
import { formatDate, formatSetLength } from '../../../lib/format';
import { LOCALES, t, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  // The bucket's minutes as a plain number ("10", not "10 min") — simpler
  // than the length label, and doesn't need urlSafe (see songs/[id].astro)
  // since a bare integer has none of the characters that need escaping.
  return LOCALES.flatMap((lang) =>
    setLengthStats.buckets.map((bucket) => ({
      params: { lang, length: String(bucket.minutes) },
      props: { bucket, lang },
    })),
  );
}

const { bucket, lang } = Astro.props as { bucket: LengthBucket; lang: Lang };
const base = import.meta.env.BASE_URL;
// Most recent first, matching the events list's ordering convention.
const eventIds = bucket.event_ids.slice().reverse();
---

<Layout title={formatSetLength(lang, bucket.minutes)} lang={lang} path={`set-lengths/${bucket.minutes}/`}>
  <p><a href="../">{t(lang, 'setLength.back')}</a></p>

  <h1>{formatSetLength(lang, bucket.minutes)}</h1>

  <table class="meta-table">
    <tr>
      <th>{t(lang, 'setLength.shows')}</th>
      <td>{bucket.shows}</td>
    </tr>
    <tr>
      <th>{t(lang, 'setLength.avgSongs')}</th>
      <td>{bucket.avg_songs}</td>
    </tr>
    <tr>
      <th>{t(lang, 'setLength.withSe')}</th>
      <td>
        {t(lang, 'setLength.withSeDetail', {
          count: bucket.shows_with_se,
          shows: bucket.shows,
          pct: Math.round((bucket.shows_with_se / bucket.shows) * 100),
        })}
      </td>
    </tr>
  </table>
  <p class="uncovered-note">{t(lang, 'setLength.avgSongsNote')}</p>

  <ul style="list-style:none; padding:0;">
    {
      eventIds.map((id) => {
        const event = getEvent(id);
        if (!event) return null;
        return (
          <li>
            <a class="event-card" href={`${base}/${lang}/events/${id}/`}>
              <div class="event-date">{formatDate(lang, event.date)}</div>
              <div class="event-title">
                {event.title}
                {event.setlist.some((s) => s.is_se) && <span class="badge">{t(lang, 'setLength.withSe')}</span>}
              </div>
              {event.venue && <div class="event-venue">{event.venue}</div>}
            </a>
          </li>
        );
      })
    }
  </ul>
</Layout>
