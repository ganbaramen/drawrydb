---
import Layout from '../../../layouts/Layout.astro';
import EventCard from '../../../components/EventCard.astro';
import MetaRow from '../../../components/MetaRow.astro';
import MetaTable from '../../../components/MetaTable.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { Badge } from '@/components/ui/badge';
import { ItemGroup } from '@/components/ui/item';
import { setLengthStats, getEvent, type LengthBucket } from '../../../lib/data';
import { formatDate, formatSetLength } from '../../../lib/format';
import { LOCALES, t, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  // The bucket's minutes as a plain number ("10", not "10 min") — simpler
  // than the length label, and doesn't need urlSafe (see songs/[id].astro)
  // since a bare integer has none of the characters that need escaping.
  return LOCALES.flatMap((lang) =>
    setLengthStats.buckets.map((bucket) => ({
      params: { lang, length: String(bucket.minutes) },
      props: { bucket, lang },
    })),
  );
}

const { bucket, lang } = Astro.props as { bucket: LengthBucket; lang: Lang };
const base = import.meta.env.BASE_URL;
// Most recent first, matching the events list's ordering convention.
const eventIds = bucket.event_ids.slice().reverse();
---

<Layout title={formatSetLength(lang, bucket.minutes)} lang={lang} path={`set-lengths/${bucket.minutes}/`}>
  <PageHeader
    title={formatSetLength(lang, bucket.minutes)}
    backHref="../"
    backLabel={t(lang, 'setLength.back')}
  />

  <MetaTable>
    <MetaRow label={t(lang, 'setLength.shows')}>{bucket.shows}</MetaRow>
    <MetaRow label={t(lang, 'setLength.avgSongs')}>{bucket.avg_songs}</MetaRow>
    <MetaRow label={t(lang, 'setLength.withSe')}>
      {t(lang, 'setLength.withSeDetail', {
        count: bucket.shows_with_se,
        shows: bucket.shows,
        pct: Math.round((bucket.shows_with_se / bucket.shows) * 100),
      })}
    </MetaRow>
  </MetaTable>
  <p class="text-muted-foreground -mt-2 text-xs">{t(lang, 'setLength.avgSongsNote')}</p>

  <ItemGroup class="gap-2.5">
    {
      eventIds.map((id) => {
        const event = getEvent(id);
        if (!event) return null;
        return (
          <EventCard
            href={`${base}/${lang}/events/${id}/`}
            date={formatDate(lang, event.date)}
            title={event.title}
            venue={event.venue}
          >
            {event.setlist.some((s) => s.is_se) && (
              <Badge slot="badge" variant="outline">
                {t(lang, 'setLength.withSe')}
              </Badge>
            )}
          </EventCard>
        );
      })
    }
  </ItemGroup>
</Layout>
