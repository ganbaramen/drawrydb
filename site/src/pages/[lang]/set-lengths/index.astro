---
import Layout from '../../../layouts/Layout.astro';
import { setLengthStats } from '../../../lib/data';
import { formatSetLength, songDisplayName, urlSafe } from '../../../lib/format';
import { LOCALES, t, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const base = import.meta.env.BASE_URL;
const { buckets, songs, uncovered_shows } = setLengthStats;
---

<Layout title={t(lang, 'setLength.title')} lang={lang} path="set-lengths/">
  <h1>{t(lang, 'setLength.title')}</h1>

  <div class="table-scroll">
    <table class="stats-table" id="bucket-table">
      <thead>
        <tr>
          <th>{t(lang, 'setLength.length')}</th>
          <th data-sort-type="number">{t(lang, 'setLength.shows')}</th>
          <th data-sort-type="number">{t(lang, 'setLength.avgSongs')}</th>
          <th data-sort-type="number">{t(lang, 'setLength.withSe')}</th>
        </tr>
      </thead>
      <tbody>
        {
          buckets.map((b) => (
            <tr>
              <td>
                <a href={`${base}/${lang}/set-lengths/${b.minutes}/`}>{formatSetLength(lang, b.minutes)}</a>
              </td>
              <td data-sort-value={b.shows}>{b.shows}</td>
              <td data-sort-value={b.avg_songs}>{b.avg_songs}</td>
              <td data-sort-value={b.shows_with_se / b.shows}>
                {t(lang, 'setLength.withSeDetail', {
                  count: b.shows_with_se,
                  shows: b.shows,
                  pct: Math.round((b.shows_with_se / b.shows) * 100),
                })}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="uncovered-note">{t(lang, 'setLength.avgSongsNote')}</p>

  {uncovered_shows > 0 && <p class="uncovered-note">{t(lang, 'setLength.uncovered', { n: uncovered_shows })}</p>}

  <h2>{t(lang, 'setLength.songDistribution')}</h2>
  <label class="include-special">
    <input type="checkbox" id="include-special" checked />
    {t(lang, 'songs.includeSpecial')}
  </label>
  <div class="table-scroll">
    <table class="stats-table" id="song-distribution-table">
      <thead>
        <tr>
          <th>{t(lang, 'setLength.songName')}</th>
          {buckets.map((b) => <th data-sort-type="number">{formatSetLength(lang, b.minutes)}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          songs.map((song) => (
            <tr data-special={song.is_se || song.is_interlude ? '1' : '0'}>
              <td>
                <a href={`${base}/${lang}/songs/${urlSafe(song.id)}/`}>{songDisplayName(lang, song)}</a>
              </td>
              {buckets.map((b) => {
                const rate = song.rates[String(b.minutes)] ?? { count: 0, eligible: 0 };
                if (rate.eligible === 0) {
                  return <td data-sort-value={-1}>—</td>;
                }
                return (
                  <td data-sort-value={rate.count / rate.eligible}>
                    {t(lang, 'setLength.rateDetail', {
                      pct: Math.round((rate.count / rate.eligible) * 100),
                      count: rate.count,
                      shows: rate.eligible,
                    })}
                  </td>
                );
              })}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <script>
    import { initSortableTable } from '../../../lib/sortable-table';
    initSortableTable(document.getElementById('bucket-table') as HTMLTableElement);
    initSortableTable(document.getElementById('song-distribution-table') as HTMLTableElement);

    const checkbox = document.getElementById('include-special') as HTMLInputElement;
    const rows = document.querySelectorAll<HTMLTableRowElement>('#song-distribution-table tbody tr');

    function apply() {
      rows.forEach((row) => {
        row.hidden = !checkbox.checked && row.dataset.special === '1';
      });
    }

    checkbox.addEventListener('change', apply);
  </script>
</Layout>
