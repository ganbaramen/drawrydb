---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import SpecialFilter from '../../../components/SpecialFilter.astro';
import StatsTable from '../../../components/StatsTable.astro';
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@/components/ui/table';
import { setLengthStats } from '../../../lib/data';
import { formatSetLength, songDisplayName, urlSafe } from '../../../lib/format';
import { LOCALES, t, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const base = import.meta.env.BASE_URL;
const { buckets, songs, uncovered_shows } = setLengthStats;
---

<Layout title={t(lang, 'setLength.title')} lang={lang} path="set-lengths/">
  <PageHeader title={t(lang, 'setLength.title')} />

  <StatsTable>
    <Table id="bucket-table">
      <TableHeader>
        <TableRow>
          <TableHead>{t(lang, 'setLength.length')}</TableHead>
          <TableHead class="text-right" data-sort-type="number">{t(lang, 'setLength.shows')}</TableHead>
          <TableHead class="text-right" data-sort-type="number">{t(lang, 'setLength.avgSongs')}</TableHead>
          <TableHead class="text-right" data-sort-type="number">{t(lang, 'setLength.withSe')}</TableHead>
        </TableRow>
      </TableHeader>
      <TableBody>
        {
          buckets.map((b) => (
            <TableRow>
              <TableCell class="font-medium">
                <a href={`${base}/${lang}/set-lengths/${b.minutes}/`}>{formatSetLength(lang, b.minutes)}</a>
              </TableCell>
              <TableCell class="text-right tabular-nums" data-sort-value={b.shows}>{b.shows}</TableCell>
              <TableCell class="text-right tabular-nums" data-sort-value={b.avg_songs}>{b.avg_songs}</TableCell>
              <TableCell
                class="text-muted-foreground text-right tabular-nums"
                data-sort-value={b.shows_with_se / b.shows}
              >
                {t(lang, 'setLength.withSeDetail', {
                  count: b.shows_with_se,
                  shows: b.shows,
                  pct: Math.round((b.shows_with_se / b.shows) * 100),
                })}
              </TableCell>
            </TableRow>
          ))
        }
      </TableBody>
    </Table>
  </StatsTable>

  <div class="text-muted-foreground -mt-2 space-y-1 text-xs">
    <p>{t(lang, 'setLength.avgSongsNote')}</p>
    {uncovered_shows > 0 && <p>{t(lang, 'setLength.uncovered', { n: uncovered_shows })}</p>}
  </div>

  <section class="flex flex-col gap-3">
    <SectionHeading>{t(lang, 'setLength.songDistribution')}</SectionHeading>
    <SpecialFilter label={t(lang, 'songs.includeSpecial')} />

    <StatsTable>
      <Table id="song-distribution-table">
        <TableHeader>
          <TableRow>
            <TableHead>{t(lang, 'setLength.songName')}</TableHead>
            {buckets.map((b) => (
              <TableHead class="text-right" data-sort-type="number">
                {formatSetLength(lang, b.minutes)}
              </TableHead>
            ))}
          </TableRow>
        </TableHeader>
        <TableBody>
          {
            songs.map((song) => (
              <TableRow data-special={song.is_se || song.is_interlude ? '1' : '0'}>
                <TableCell class="font-medium">
                  <a href={`${base}/${lang}/songs/${urlSafe(song.id)}/`}>{songDisplayName(lang, song)}</a>
                </TableCell>
                {buckets.map((b) => {
                  const rate = song.rates[String(b.minutes)] ?? { count: 0, eligible: 0 };
                  // Empty sort value, not -1: sortable-table.ts sinks a cell
                  // it cannot parse as a number to the bottom in BOTH
                  // directions, which is the site's blanks-last rule. A real
                  // -1 sorts as a number, so it led ascending instead.
                  if (rate.eligible === 0) {
                    return (
                      <TableCell class="text-muted-foreground/50 text-right" data-sort-value="">
                        —
                      </TableCell>
                    );
                  }
                  return (
                    <TableCell class="text-right tabular-nums" data-sort-value={rate.count / rate.eligible}>
                      {t(lang, 'setLength.rateDetail', {
                        pct: Math.round((rate.count / rate.eligible) * 100),
                        count: rate.count,
                        shows: rate.eligible,
                      })}
                    </TableCell>
                  );
                })}
              </TableRow>
            ))
          }
        </TableBody>
      </Table>
    </StatsTable>
  </section>

  <script>
    import { initSortableTable } from '../../../lib/sortable-table';
    initSortableTable(document.getElementById('bucket-table') as HTMLTableElement);
    initSortableTable(document.getElementById('song-distribution-table') as HTMLTableElement);

    const checkbox = document.getElementById('include-special') as HTMLInputElement;
    const rows = document.querySelectorAll<HTMLTableRowElement>('#song-distribution-table tbody tr');

    function apply() {
      rows.forEach((row) => {
        row.hidden = !checkbox.checked && row.dataset.special === '1';
      });
    }

    checkbox.addEventListener('change', apply);

    // Run once on load, not only on change: a browser restoring the
    // checkbox's state (reload, back-forward cache) can hand us a page whose
    // control and rows disagree. The events index does the same for the same
    // reason.
    apply();
  </script>
</Layout>
