---
import Layout from '../../../layouts/Layout.astro';
import MetaRow from '../../../components/MetaRow.astro';
import MetaTable from '../../../components/MetaTable.astro';
import PageHeader from '../../../components/PageHeader.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import { Alert, AlertDescription } from '@/components/ui/alert';
import { Badge } from '@/components/ui/badge';
import { Card, CardContent } from '@/components/ui/card';
import { Icon } from '@/components/ui/icon';
import { events, getSong, getVenue, setLengthStats, type Event } from '../../../lib/data';
import { formatDate, formatDateTime, formatSetLength, liveDurationMinutes, songDisplayName, urlSafe } from '../../../lib/format';
import { LOCALES, t, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  return LOCALES.flatMap((lang) =>
    events.map((event) => ({
      params: { lang, id: event.id },
      props: { event, lang },
    })),
  );
}

const { event, lang } = Astro.props as { event: Event; lang: Lang };
const base = import.meta.env.BASE_URL;
// A pending event's venue may be blank, or an unresolved multi-venue string
// the calendar couldn't disambiguate (see CLAUDE.md's VENUE_AMBIGUOUS) — only
// setlist-derived venues get their own page, so only link when one exists.
const venue = event.venue ? getVenue(event.venue) : undefined;
// Multiple encores need their own numbers to tell them apart (e.g.
// 新衣装お披露目イベント Drawry.主催「New Scene」 has two) — the common
// single-encore case stays plain "En" rather than an unnecessary "En1".
const encoreCount = event.setlist.filter((s) => s.is_encore).length;
let encoreIndex = 0;
// This show's set-length bucket, if it has one — same partial coverage as
// shows.csv's length_bucket (only shows with both live_start/live_end).
const bucket = setLengthStats.buckets.find((b) => b.event_ids.includes(event.id));
const durationMinutes =
  event.live_start && event.live_end ? liveDurationMinutes(event.live_start, event.live_end) : null;
// 特典会 (meet & greet) duration — no set-length bucket/page for this one
// (unlike the live set), just the plain "(N分)"/"(N min)" text.
const meetDurationMinutes =
  event.meet_start && event.meet_end ? liveDurationMinutes(event.meet_start, event.meet_end) : null;
---

<Layout title={event.title} lang={lang} path={`events/${event.id}/`}>
  <PageHeader title={event.title} backHref="../" backLabel={t(lang, 'events.back')}>
    <p slot="subtitle" class="text-muted-foreground text-sm">{formatDate(lang, event.date)}</p>
  </PageHeader>

  <MetaTable>
    {event.venue && (
      <MetaRow label={t(lang, 'events.venue')}>
        {venue ? (
          <a href={`${base}/${lang}/venues/${urlSafe(venue.id)}/`}>{event.venue}</a>
        ) : (
          event.venue
        )}
      </MetaRow>
    )}
    {event.doors && <MetaRow label={t(lang, 'events.doors')}>{event.doors}</MetaRow>}
    {event.showtime && <MetaRow label={t(lang, 'events.showtime')}>{event.showtime}</MetaRow>}
    {event.live_start && (
      <MetaRow label={t(lang, 'events.live')}>
        {event.live_start}
        {event.live_end && `${t(lang, 'events.timeRangeSep')}${event.live_end}`}
        {durationMinutes !== null &&
          (bucket ? (
            <>
              {/* Space only in English: the full-width pair carries its own
                  side bearing, so a space before （ reads as a gap. Same rule
                  parenthesize() applies everywhere the aside is plain text —
                  it cannot be used here because a link sits inside. */}
              {lang === 'ja' ? '（' : ' ('}
              {/* The parens stay outside the link — inside, the anchor's
                  underline stretched under them too, which reads oddly
                  wide especially with JA's full-width （）. */}
              <a href={`${base}/${lang}/set-lengths/${bucket.minutes}/`}>
                {formatSetLength(lang, durationMinutes)}
              </a>
              {lang === 'ja' ? '）' : ')'}
            </>
          ) : (
            ` ${t(lang, 'events.liveDuration', { n: durationMinutes })}`
          ))}
      </MetaRow>
    )}
    {event.meet_start && (
      <MetaRow label={t(lang, 'events.meet')}>
        {event.meet_start}
        {event.meet_end && `${t(lang, 'events.timeRangeSep')}${event.meet_end}`}
        {meetDurationMinutes !== null && ` ${t(lang, 'events.liveDuration', { n: meetDurationMinutes })}`}
      </MetaRow>
    )}
    {event.ticket_links.length > 0 && (
      <MetaRow label={t(lang, 'events.tickets')}>
        <ul class="flex flex-col gap-1">
          {event.ticket_links.map((link) => (
            <li>
              <a
                class="inline-flex items-center gap-1"
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {link.label ?? link.url}
                <Icon name="external-link" class="size-3 opacity-60" aria-hidden="true" />
                <span class="sr-only">{t(lang, 'a11y.newTab')}</span>
              </a>
            </li>
          ))}
        </ul>
      </MetaRow>
    )}
    {event.ticket_sales.length > 0 && (
      <MetaRow label={t(lang, 'events.sale')}>
        <ul class="flex flex-col gap-1">
          {event.ticket_sales.map((sale) => {
            // Label words (先行/一般/超先行) come straight from the
            // poster prose; the common no-tier case renders just the time.
            const start = sale.start ? formatDateTime(lang, sale.start) : null;
            const end = sale.end ? formatDateTime(lang, sale.end) : null;
            const when = start && end
              ? t(lang, 'events.saleRange', { start, end })
              : start ?? (end ? `${t(lang, 'events.timeRangeSep')}${end}` : '');
            // Label words (先行/一般/超先行) are Japanese either way; 一般
            // gets a translated word since it's the one generic term.
            const rawLabel = sale.label === '一般' ? t(lang, 'events.saleGeneral') : sale.label;
            const open = lang === 'ja' ? '（' : '(';
            const close = lang === 'ja' ? '）' : ')';
            return (
              <li>
                {when}
                {rawLabel && `${open}${rawLabel}${close}`}
              </li>
            );
          })}
        </ul>
      </MetaRow>
    )}
  </MetaTable>

  {
    event.has_setlist ? (
      <Card size="sm">
        <CardContent class="px-0">
          <ol class="flex flex-col">
            {event.setlist.map((song) => {
              if (song.is_encore) encoreIndex++;
              const position = song.is_encore ? (encoreCount > 1 ? `En${encoreIndex}` : 'En') : song.position;
              // Fall back to the raw name if a setlist entry somehow doesn't
              // match a song_stats.csv row — shouldn't happen, but a dead link
              // beats a build failure.
              const matchedSong = getSong(song.song);
              const songId = matchedSong?.id ?? song.song;
              const songName = matchedSong ? songDisplayName(lang, matchedSong) : song.song;
              return (
                <li class="hover:bg-muted/50 flex items-baseline gap-3 border-b px-4 py-2.5 transition-colors last:border-b-0">
                  <span class="text-muted-foreground min-w-[2.5ch] text-xs tabular-nums">{position}</span>
                  <span>
                    <a href={`${base}/${lang}/songs/${urlSafe(songId)}/`}>{songName}</a>
                    {song.note && <span class="text-muted-foreground text-xs"> ({song.note})</span>}
                  </span>
                  {song.is_encore && (
                    <Badge variant="outline" class="ml-auto self-center">
                      {t(lang, 'badge.encore')}
                    </Badge>
                  )}
                </li>
              );
            })}
          </ol>
        </CardContent>
      </Card>
    ) : (
      <Alert>
        <Icon name="clock" />
        <AlertDescription>{t(lang, 'events.pending')}</AlertDescription>
      </Alert>
    )
  }

  {
    event.note && (
      <section class="flex flex-col gap-2">
        <SectionHeading>{t(lang, 'events.note')}</SectionHeading>
        <Card size="sm">
          <CardContent class="event-note text-sm">{event.note}</CardContent>
        </Card>
      </section>
    )
  }
</Layout>
