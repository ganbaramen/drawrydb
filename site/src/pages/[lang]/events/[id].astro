---
import Layout from '../../../layouts/Layout.astro';
import { events, getVenue, type Event } from '../../../lib/data';
import { formatDate, liveDurationMinutes, urlSafe } from '../../../lib/format';
import { LOCALES, t, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  return LOCALES.flatMap((lang) =>
    events.map((event) => ({
      params: { lang, id: event.id },
      props: { event, lang },
    })),
  );
}

const { event, lang } = Astro.props as { event: Event; lang: Lang };
const base = import.meta.env.BASE_URL;
// A pending event's venue may be blank, or an unresolved multi-venue string
// the calendar couldn't disambiguate (see CLAUDE.md's VENUE_AMBIGUOUS) — only
// setlist-derived venues get their own page, so only link when one exists.
const venue = event.venue ? getVenue(event.venue) : undefined;
// Multiple encores need their own numbers to tell them apart (e.g.
// 新衣装お披露目イベント Drawry.主催「New Scene」 has two) — the common
// single-encore case stays plain "En" rather than an unnecessary "En1".
const encoreCount = event.setlist.filter((s) => s.is_encore).length;
let encoreIndex = 0;
---

<Layout title={event.title} lang={lang} path={`events/${event.id}/`}>
  <p><a href="../">{t(lang, 'events.back')}</a></p>

  <h1>{event.title}</h1>
  <p class="event-date">{formatDate(lang, event.date)}</p>

  <table class="meta-table">
    {event.venue && (
      <tr>
        <th>{t(lang, 'events.venue')}</th>
        <td>
          {venue ? (
            <a href={`${base}/${lang}/venues/${urlSafe(venue.id)}/`}>{event.venue}</a>
          ) : (
            event.venue
          )}
        </td>
      </tr>
    )}
    {event.doors && (
      <tr>
        <th>{t(lang, 'events.doors')}</th>
        <td>{event.doors}</td>
      </tr>
    )}
    {event.showtime && (
      <tr>
        <th>{t(lang, 'events.showtime')}</th>
        <td>{event.showtime}</td>
      </tr>
    )}
    {event.live_start && (
      <tr>
        <th>{t(lang, 'events.live')}</th>
        <td>
          {event.live_start}
          {event.live_end && `${t(lang, 'events.timeRangeSep')}${event.live_end}`}
          {event.live_end &&
            ` ${t(lang, 'events.liveDuration', { n: liveDurationMinutes(event.live_start, event.live_end) })}`}
        </td>
      </tr>
    )}
    {event.ticket_links.length > 0 && (
      <tr>
        <th>{t(lang, 'events.tickets')}</th>
        <td>
          <ul class="ticket-links">
            {event.ticket_links.map((link) => (
              <li>
                <a href={link.url} target="_blank" rel="noopener noreferrer">
                  {link.label ?? link.url}
                </a>
              </li>
            ))}
          </ul>
        </td>
      </tr>
    )}
  </table>

  {
    event.has_setlist ? (
      <ol class="setlist">
        {event.setlist.map((song) => {
          if (song.is_encore) encoreIndex++;
          const position = song.is_encore ? (encoreCount > 1 ? `En${encoreIndex}` : 'En') : song.position;
          return (
            <li>
              <span class="position">{position}</span>
              <span>
                <a href={`${base}/${lang}/songs/${urlSafe(song.song)}/`}>{song.song}</a>
                {song.note && <span class="song-note"> ({song.note})</span>}
              </span>
            </li>
          );
        })}
      </ol>
    ) : (
      <p class="pending-notice">{t(lang, 'events.pending')}</p>
    )
  }
</Layout>
