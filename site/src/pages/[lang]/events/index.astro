---
import Layout from '../../../layouts/Layout.astro';
import EventCard from '../../../components/EventCard.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { Badge } from '@/components/ui/badge';
import { Icon } from '@/components/ui/icon';
import { Input } from '@/components/ui/input';
import { ItemGroup } from '@/components/ui/item';
import { events } from '../../../lib/data';
import { formatDate, formatMonth } from '../../../lib/format';
import { LOCALES, t, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const base = import.meta.env.BASE_URL;
// Reverse chronological, per DRAWRYDB.md's route plan.
const sorted = events.slice().reverse();
const hasSetlistCount = events.filter((event) => event.has_setlist).length;
// All three totals are rendered up front so the count stays truthful with
// scripts off: the radios move which one is shown, in CSS. The script
// replaces the whole element's text on its first pass, so only one of these
// is ever live at a time.
const filterCounts: Record<string, number> = {
  has: hasSetlistCount,
  none: events.length - hasSetlistCount,
  all: events.length,
};
// Client script reuses this template (with {n} swapped for the live count)
// so it doesn't need its own copy of the locale's count phrasing.
const countTemplate = t(lang, 'events.count', { n: '__N__' });

// Group into months (most recent first, matching `sorted`) so the list can
// get a heading per month plus a jump-to-month nav — 163 events in one flat
// scroll had no way to get to e.g. "last February" short of scrolling past
// everything after it.
const monthKeys: string[] = [];
const eventsByMonth = new Map<string, typeof sorted>();
for (const event of sorted) {
  const key = event.date.slice(0, 7);
  if (!eventsByMonth.has(key)) {
    eventsByMonth.set(key, []);
    monthKeys.push(key);
  }
  eventsByMonth.get(key)!.push(event);
}

// The index opens on すべて. It used to open on セトリあり, which reads as the
// right default for an archive — but it hid every *future* show, so someone
// arriving to check what was coming up saw 143 of 171 events and concluded
// there was nothing scheduled. The home page's next-live card was the only
// other route to that answer. Showing everything by default costs a history
// browser one click; hiding upcoming shows cost the other visitor the
// answer entirely, with nothing on screen saying a filter was in force.
const DEFAULT_FILTER = 'all';

// DEFAULT_FILTER first. The order used to be has/none/all, from when
// `has` was the default; leaving it that way after the default moved put
// the selected position last, so the control opened with its highlight at
// the far end and the two narrowing options to its left — backwards for a
// segmented control, and backwards for arrow-key order too, since a radio
// group starts on the checked one and steps outward from there.
const setlistFilters = [
  { value: 'all', label: t(lang, 'events.filter.all') },
  { value: 'has', label: t(lang, 'events.filter.has') },
  { value: 'none', label: t(lang, 'events.filter.none') },
];
---

<Layout title={t(lang, 'events.title')} lang={lang} path="events/">
  <PageHeader title={t(lang, 'events.title')} />

  <!--
    What works without JavaScript, and what is not offered at all.

    The three-way setlist filter is **fully functional** in CSS: every rule
    keys off which radio is `:checked`, so switching position moves the rows,
    collapses months that empty out, and swaps the visible total. It used to
    key off the list's data-filter attribute, which only the script ever
    wrote — so a click moved the segmented control's highlight and nothing
    else, which is worse feedback than none.

    The search box and the month select genuinely cannot work without script,
    so they carry data-needs-js and global.css does not render them unless
    <html> has data-js. An absent control is honest; an inert one is not.

    Adding a fourth filter value means adding its count, its row rule and its
    month rule in global.css.
  -->
  <div class="flex flex-col gap-3">
    <div class="relative" data-needs-js>
      <Input
        type="search"
        id="event-search"
        class="pr-9 [&::-webkit-search-cancel-button]:appearance-none [&::-webkit-search-decoration]:appearance-none"
        placeholder={t(lang, 'events.search.placeholder')}
      />
      <Icon
        name="search"
        class="text-muted-foreground pointer-events-none absolute top-1/2 right-3 size-4 -translate-y-1/2"
      />
    </div>

    <div class="flex flex-wrap items-center gap-x-2 gap-y-2 text-sm">
      <!--
        Radios styled as a segmented control: the input itself is visually
        hidden (not display:none, which would drop it out of the tab order)
        and the label paints the selected state off :has(:checked).

        Selected uses accent (the same pale-purple/lavender pair the header
        nav's current section gets), not a raised bg-card pill: --card is
        *darker* than --muted in the dark palette, so a card-colored pill on
        a muted track read as recessed rather than selected.
      -->
      <div
        class="bg-muted inline-flex rounded-lg p-0.5"
        role="group"
        aria-label={t(lang, 'events.title')}
      >
        {
          setlistFilters.map((filter) => (
            <label class="has-[:checked]:bg-accent has-[:checked]:text-accent-foreground has-[:focus-visible]:ring-ring/50 text-muted-foreground hover:text-foreground cursor-pointer rounded-md px-2.5 py-1 text-xs font-medium transition-colors has-[:focus-visible]:ring-3">
              <input
                type="radio"
                name="setlist-filter"
                value={filter.value}
                checked={filter.value === DEFAULT_FILTER}
                class="sr-only"
              />
              {filter.label}
            </label>
          ))
        }
      </div>

      <label class="text-muted-foreground ml-auto inline-flex items-center gap-1.5 text-xs" data-needs-js>
        {t(lang, 'events.month.label')}
        <select
          id="month-filter"
          class="border-input bg-card text-foreground focus-visible:border-ring focus-visible:ring-ring/50 h-8 rounded-md border px-2 text-xs shadow-xs outline-none focus-visible:ring-3"
        >
          {/*
            Counted against DEFAULT_FILTER, not against has_setlist, so the
            labels agree with the view actually being delivered. The script
            recomputes them on its first pass anyway — and this select is
            not rendered at all without script — but a number that is wrong
            for the shipped state is worth not writing down.
          */}
          <option value="all" data-label={t(lang, 'events.month.all')}>
            {t(lang, 'events.month.all')} ({events.length})
          </option>
          {
            monthKeys.map((key) => {
              const label = formatMonth(lang, key);
              const count = eventsByMonth.get(key)!.length;
              return (
                <option value={key} data-label={label}>
                  {label} ({count})
                </option>
              );
            })
          }
        </select>
      </label>
    </div>

    <p id="event-count" class="text-muted-foreground text-sm" data-template={countTemplate}>
      {
        setlistFilters.map((filter) => (
          <span data-count={filter.value}>
            {t(lang, 'events.count', { n: filterCounts[filter.value] })}
          </span>
        ))
      }
    </p>

    <!--
      The announcement channel, separate from the visible count above.
      Putting role="status" on the visible count did not work: VoiceOver on
      Chrome ignored it entirely — typing spoke only the character echo and
      changing the filter spoke only the radio, never the new total.
      Verified by ear.

      This region ships **empty** and is written to on a debounce, which is
      the pattern VoiceOver does honour: it announces content added to a
      region that was empty far more reliably than a wholesale replacement
      of text that was already there. Keeping the live attributes in one
      place also means no assistive technology announces the count twice.
    -->
    <p id="event-announce" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
  </div>

  {/*
    One list per month, with the heading *outside* it, rather than one list
    holding headings and cards together. The earlier shape wrapped each
    heading in a role="presentation" <li> to keep it out of the item count;
    VoiceOver counted it anyway and announced "1 of 155" — the 143 cards
    plus the 12 visible headings — disagreeing with the page's own 143件.
    Heard, not inferred.

    With the heading lifted out, each month is a list of just its cards, so
    a position is announced against the month a visitor is actually in.

    Heading and list are now wrapped in one <section class="month">, so
    emptying a month hides both together — one CSS rule with scripts off,
    one `hidden` flip with them on, instead of a heading rule plus a
    next-sibling rule that could disagree.

    data-filter is still written by the script but **nothing reads it any
    more**: the CSS moved to `:has(:checked)` so the live radio is the only
    thing that decides, which is what makes the filter work without script
    at all. It stays because it is the cheapest way to read the active
    filter back from a console.
  */}
  <div id="event-list" data-filter={DEFAULT_FILTER} class="flex flex-col gap-2">
    {
      monthKeys.map((key) => (
        <section class="month flex flex-col gap-2" data-month={key}>
          <h2
            class="month-heading text-muted-foreground scroll-mt-20 pt-4 text-sm font-semibold"
            id={`m-${key}`}
          >
            {formatMonth(lang, key)}
          </h2>
          <ItemGroup class="gap-2" aria-labelledby={`m-${key}`}>
          {eventsByMonth.get(key)!.map((event) => (
            <EventCard
              href={`${base}/${lang}/events/${event.id}/`}
              date={formatDate(lang, event.date)}
              title={event.title}
              venue={event.venue}
              data-has-setlist={event.has_setlist ? '1' : '0'}
              data-month={key}
              data-search={`${event.title} ${event.venue ?? ''}`}
            >
              {!event.has_setlist && (
                <Badge slot="badge" variant="secondary">
                  {t(lang, 'badge.pending')}
                </Badge>
              )}
            </EventCard>
          ))}
          </ItemGroup>
        </section>
      ))
    }
  </div>

  <script>
    import { fuzzyMatch } from '../../../lib/fuzzy';

    const list = document.getElementById('event-list')!;
    const countEl = document.getElementById('event-count')!;
    const template = countEl.dataset.template!;
    const items = list.querySelectorAll<HTMLElement>('[data-has-setlist]');
    // Each month is one <section class="month"> holding its heading and its
    // list, so emptying a month hides both in one flip. They used to be
    // siblings and the heading's next element had to be hidden alongside it.
    const months = list.querySelectorAll<HTMLElement>('.month');
    const radios = document.querySelectorAll<HTMLInputElement>(
      'input[name="setlist-filter"]',
    );
    const monthSelect = document.getElementById('month-filter') as HTMLSelectElement;
    const searchInput = document.getElementById('event-search') as HTMLInputElement;

    function apply() {
      const setlistFilter = document.querySelector<HTMLInputElement>(
        'input[name="setlist-filter"]:checked',
      )!.value;
      const monthFilter = monthSelect.value;
      const query = searchInput.value.trim();
      list.dataset.filter = setlistFilter;

      // One pass over all 163 events computes both the per-month option
      // counts and each row's visibility — cheap enough (well under a
      // millisecond) to redo on every keystroke rather than precomputing
      // combinations of setlist-filter × search at build time, which
      // isn't possible anyway since the search query only exists at
      // runtime.
      let visible = 0;
      const monthCounts = new Map<string, number>();
      const monthHasVisible = new Map<string, boolean>();

      items.forEach((item) => {
        const has = item.dataset.hasSetlist === '1';
        const month = item.dataset.month!;
        const matchesSetlist = setlistFilter === 'all' || (setlistFilter === 'has') === has;
        const matchesSearch = fuzzyMatch(query, item.dataset.search ?? '');
        if (matchesSetlist && matchesSearch) {
          monthCounts.set(month, (monthCounts.get(month) ?? 0) + 1);
        }

        const matchesMonth = monthFilter === 'all' || monthFilter === month;
        const show = matchesSetlist && matchesSearch && matchesMonth;
        item.hidden = !show;
        if (show) {
          visible++;
          monthHasVisible.set(month, true);
        }
      });

      const totalMatching = Array.from(monthCounts.values()).reduce((a, b) => a + b, 0);
      Array.from(monthSelect.options).forEach((opt) => {
        const count = opt.value === 'all' ? totalMatching : monthCounts.get(opt.value) ?? 0;
        opt.textContent = `${opt.dataset.label} (${count})`;
      });

      months.forEach((section) => {
        const month = section.dataset.month!;
        const matchesMonth = monthFilter === 'all' || monthFilter === month;
        section.hidden = !matchesMonth || !monthHasVisible.get(month);
      });

      // Replaces the three build-time spans (one per filter position) with a
      // single live string on the first pass. From then on the CSS rules that
      // pick between them have nothing to match, which is intended: with the
      // script running, the count reflects search and month too, which no
      // static total can.
      const text = template.replace('__N__', String(visible));
      countEl.textContent = text;
      announce(text);
    }

    // VoiceOver on Chrome ignored aria-live on the visible count entirely:
    // typing spoke only the character echo, changing the filter only the
    // radio. Writing into a region that ships empty is the pattern it does
    // honour, and clearing first means two identical results still read as
    // a change rather than being swallowed as "no new content".
    //
    // Debounced so a burst of keystrokes produces one announcement at the
    // end rather than one per character, which is also why the region is
    // polite: it waits for a pause instead of interrupting the typing echo.
    const announceEl = document.getElementById('event-announce')!;
    let announceTimer: number | undefined;
    // The load-time apply() must not speak: a visitor arriving should hear
    // the page, not a count read at them before they have done anything.
    // Only a change the visitor caused is worth announcing.
    let announcing = false;
    function announce(text: string) {
      if (!announcing) return;
      window.clearTimeout(announceTimer);
      announceTimer = window.setTimeout(() => {
        announceEl.textContent = '';
        window.setTimeout(() => {
          announceEl.textContent = text;
        }, 100);
      }, 500);
    }

    radios.forEach((radio) => {
      radio.addEventListener('change', apply);
    });
    monthSelect.addEventListener('change', apply);
    searchInput.addEventListener('input', apply);

    // The setlist filter and the month blocks both work from CSS alone (see
    // the comment above the filters). This first pass takes over: it folds in
    // search and the month select, which CSS cannot do, and swaps the count
    // to a live one.
    apply();
    announcing = true;
  </script>
</Layout>

