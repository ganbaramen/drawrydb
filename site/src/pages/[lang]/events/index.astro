---
import Layout from '../../../layouts/Layout.astro';
import EventCard from '../../../components/EventCard.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { Badge } from '@/components/ui/badge';
import { Icon } from '@/components/ui/icon';
import { Input } from '@/components/ui/input';
import { ItemGroup } from '@/components/ui/item';
import { events } from '../../../lib/data';
import { formatDate, formatMonth } from '../../../lib/format';
import { LOCALES, t, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const base = import.meta.env.BASE_URL;
// Reverse chronological, per DRAWRYDB.md's route plan.
const sorted = events.slice().reverse();
const hasSetlistCount = events.filter((event) => event.has_setlist).length;
// Client script reuses this template (with {n} swapped for the live count)
// so it doesn't need its own copy of the locale's count phrasing.
const countTemplate = t(lang, 'events.count', { n: '__N__' });

// Group into months (most recent first, matching `sorted`) so the list can
// get a heading per month plus a jump-to-month nav — 163 events in one flat
// scroll had no way to get to e.g. "last February" short of scrolling past
// everything after it.
const monthKeys: string[] = [];
const eventsByMonth = new Map<string, typeof sorted>();
for (const event of sorted) {
  const key = event.date.slice(0, 7);
  if (!eventsByMonth.has(key)) {
    eventsByMonth.set(key, []);
    monthKeys.push(key);
  }
  eventsByMonth.get(key)!.push(event);
}

const setlistFilters = [
  { value: 'has', label: t(lang, 'events.filter.has') },
  { value: 'none', label: t(lang, 'events.filter.none') },
  { value: 'all', label: t(lang, 'events.filter.all') },
];
---

<Layout title={t(lang, 'events.title')} lang={lang} path="events/">
  <PageHeader title={t(lang, 'events.title')} />

  <!--
    Default view (セトリあり, すべての月) works with CSS alone before the
    script below runs / if JS is disabled: the setlist radios' default
    hides via the list's data-filter attribute, and the month select's
    default ("all") needs no hiding at all. The script only adds the other
    setlist views and the month filter itself. Keep the initial
    data-filter/checked/selected state and the CSS rules below in sync if
    a filter value is ever added.
  -->
  <div class="flex flex-col gap-3">
    <div class="relative">
      <Input
        type="search"
        id="event-search"
        class="pr-9 [&::-webkit-search-cancel-button]:appearance-none [&::-webkit-search-decoration]:appearance-none"
        placeholder={t(lang, 'events.search.placeholder')}
      />
      <Icon
        name="search"
        class="text-muted-foreground pointer-events-none absolute top-1/2 right-3 size-4 -translate-y-1/2"
      />
    </div>

    <div class="flex flex-wrap items-center gap-x-2 gap-y-2 text-sm">
      <!--
        Radios styled as a segmented control: the input itself is visually
        hidden (not display:none, which would drop it out of the tab order)
        and the label paints the selected state off :has(:checked).

        Selected uses accent (the same pale-purple/lavender pair the header
        nav's current section gets), not a raised bg-card pill: --card is
        *darker* than --muted in the dark palette, so a card-colored pill on
        a muted track read as recessed rather than selected.
      -->
      <div
        class="bg-muted inline-flex rounded-lg p-0.5"
        role="group"
        aria-label={t(lang, 'events.title')}
      >
        {
          setlistFilters.map((filter) => (
            <label class="has-[:checked]:bg-accent has-[:checked]:text-accent-foreground has-[:focus-visible]:ring-ring/50 text-muted-foreground hover:text-foreground cursor-pointer rounded-md px-2.5 py-1 text-xs font-medium transition-colors has-[:focus-visible]:ring-3">
              <input
                type="radio"
                name="setlist-filter"
                value={filter.value}
                checked={filter.value === 'has'}
                class="sr-only"
              />
              {filter.label}
            </label>
          ))
        }
      </div>

      <label class="text-muted-foreground ml-auto inline-flex items-center gap-1.5 text-xs">
        {t(lang, 'events.month.label')}
        <select
          id="month-filter"
          class="border-input bg-card text-foreground focus-visible:border-ring focus-visible:ring-ring/50 h-8 rounded-md border px-2 text-xs shadow-xs outline-none focus-visible:ring-3"
        >
          <option value="all" data-label={t(lang, 'events.month.all')}>
            {t(lang, 'events.month.all')} ({hasSetlistCount})
          </option>
          {
            monthKeys.map((key) => {
              const label = formatMonth(lang, key);
              const has = eventsByMonth.get(key)!.filter((e) => e.has_setlist).length;
              return (
                <option value={key} data-label={label}>
                  {label} ({has})
                </option>
              );
            })
          }
        </select>
      </label>
    </div>

    <!--
      The site's only search. Typing rewrites this count and hides rows;
      without a live region a screen-reader user gets silence and no way to
      know whether anything matched. Polite so it waits for a pause in
      typing rather than interrupting every keystroke.
    -->
    <p
      id="event-count"
      class="text-muted-foreground text-sm"
      data-template={countTemplate}
      role="status"
      aria-live="polite"
      aria-atomic="true"
    >
      {t(lang, 'events.count', { n: hasSetlistCount })}
    </p>
  </div>

  <ItemGroup id="event-list" data-filter="has" class="gap-2">
    {
      monthKeys.map((key) => (
        <>
          {/*
            The group is a <ul>, so a bare <h2> here would be invalid — only
            <li> may be a child. role="presentation" keeps the wrapper out
            of the list's item count (so "1 of 143" counts cards, not
            headings) while the heading inside stays a real heading.
          */}
          <li role="presentation">
            <h2
              class="month-heading text-muted-foreground scroll-mt-20 pt-4 text-sm font-semibold first:pt-0"
              id={`m-${key}`}
              data-month={key}
            >
              {formatMonth(lang, key)}
            </h2>
          </li>
          {eventsByMonth.get(key)!.map((event) => (
            <EventCard
              href={`${base}/${lang}/events/${event.id}/`}
              date={formatDate(lang, event.date)}
              title={event.title}
              venue={event.venue}
              data-has-setlist={event.has_setlist ? '1' : '0'}
              data-month={key}
              data-search={`${event.title} ${event.venue ?? ''}`}
            >
              {!event.has_setlist && (
                <Badge slot="badge" variant="secondary">
                  {t(lang, 'badge.pending')}
                </Badge>
              )}
            </EventCard>
          ))}
        </>
      ))
    }
  </ItemGroup>

  <script>
    import { fuzzyMatch } from '../../../lib/fuzzy';

    const list = document.getElementById('event-list')!;
    const countEl = document.getElementById('event-count')!;
    const template = countEl.dataset.template!;
    const items = list.querySelectorAll<HTMLElement>('[data-has-setlist]');
    const headings = list.querySelectorAll<HTMLElement>('.month-heading');
    const radios = document.querySelectorAll<HTMLInputElement>(
      'input[name="setlist-filter"]',
    );
    const monthSelect = document.getElementById('month-filter') as HTMLSelectElement;
    const searchInput = document.getElementById('event-search') as HTMLInputElement;

    function apply() {
      const setlistFilter = document.querySelector<HTMLInputElement>(
        'input[name="setlist-filter"]:checked',
      )!.value;
      const monthFilter = monthSelect.value;
      const query = searchInput.value.trim();
      list.dataset.filter = setlistFilter;

      // One pass over all 163 events computes both the per-month option
      // counts and each row's visibility — cheap enough (well under a
      // millisecond) to redo on every keystroke rather than precomputing
      // combinations of setlist-filter × search at build time, which
      // isn't possible anyway since the search query only exists at
      // runtime.
      let visible = 0;
      const monthCounts = new Map<string, number>();
      const monthHasVisible = new Map<string, boolean>();

      items.forEach((item) => {
        const has = item.dataset.hasSetlist === '1';
        const month = item.dataset.month!;
        const matchesSetlist = setlistFilter === 'all' || (setlistFilter === 'has') === has;
        const matchesSearch = fuzzyMatch(query, item.dataset.search ?? '');
        if (matchesSetlist && matchesSearch) {
          monthCounts.set(month, (monthCounts.get(month) ?? 0) + 1);
        }

        const matchesMonth = monthFilter === 'all' || monthFilter === month;
        const show = matchesSetlist && matchesSearch && matchesMonth;
        item.hidden = !show;
        if (show) {
          visible++;
          monthHasVisible.set(month, true);
        }
      });

      const totalMatching = Array.from(monthCounts.values()).reduce((a, b) => a + b, 0);
      Array.from(monthSelect.options).forEach((opt) => {
        const count = opt.value === 'all' ? totalMatching : monthCounts.get(opt.value) ?? 0;
        opt.textContent = `${opt.dataset.label} (${count})`;
      });

      headings.forEach((h) => {
        const month = h.dataset.month!;
        const matchesMonth = monthFilter === 'all' || monthFilter === month;
        h.hidden = !matchesMonth || !monthHasVisible.get(month);
      });

      countEl.textContent = template.replace('__N__', String(visible));
    }

    radios.forEach((radio) => {
      radio.addEventListener('change', apply);
    });
    monthSelect.addEventListener('change', apply);
    searchInput.addEventListener('input', apply);

    // The default view (セトリあり, すべての月) works from CSS/markup alone
    // before this script runs (see the comment above the filters), but
    // heading visibility has no CSS equivalent — sync it once up front.
    apply();
  </script>
</Layout>

