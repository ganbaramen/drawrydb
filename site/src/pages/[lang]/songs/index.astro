---
import Layout from '../../../layouts/Layout.astro';
import { songs } from '../../../lib/data';
import { urlSafe } from '../../../lib/format';
import { LOCALES, t, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const base = import.meta.env.BASE_URL;
// Most-played first — that's the ordering visitors browsing "the songs" of
// a band actually want, unlike events (chronological) or venues (also by
// play count, see venues/index.astro).
const sorted = songs.slice().sort((a, b) => b.plays - a.plays);
---

<Layout title={t(lang, 'songs.title')} lang={lang} path="songs/">
  <h1>{t(lang, 'songs.title')}</h1>
  <p>{t(lang, 'songs.count', { n: songs.length })}</p>
  <table class="stats-table">
    <thead>
      <tr>
        <th>{t(lang, 'songs.name')}</th>
        <th>{t(lang, 'songs.plays')}</th>
        <th>{t(lang, 'songs.debut')}</th>
        <th>{t(lang, 'songs.playRate')}</th>
      </tr>
    </thead>
    <tbody>
      {
        sorted.map((song) => (
          <tr>
            <td>
              <a href={`${base}/${lang}/songs/${urlSafe(song.id)}/`}>{song.name}</a>
            </td>
            <td>{song.plays}</td>
            <td>{song.first_performed}</td>
            <td>{Math.round(song.play_rate * 100)}%</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</Layout>
