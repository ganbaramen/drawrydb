---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import SpecialFilter from '../../../components/SpecialFilter.astro';
import StatsTable from '../../../components/StatsTable.astro';
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@/components/ui/table';
import { songs } from '../../../lib/data';
import { formatTrackNumber, songDisplayName, urlSafe } from '../../../lib/format';
import { LOCALES, t, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const base = import.meta.env.BASE_URL;
// Debut order first (first_performed is ISO, so plain string comparison
// sorts correctly), then track number as a tiebreaker for songs debuted
// the same day — a song with no number (SE/Interlude) sorts after one
// that has it, same "blanks last" convention as the sortable columns
// below (see lib/sortable-table.ts). This is just the *default* order;
// every column here is still independently sortable by clicking it.
const sorted = songs.slice().sort((a, b) => {
  if (a.first_performed !== b.first_performed) {
    return a.first_performed < b.first_performed ? -1 : 1;
  }
  const na = a.credits?.number ? parseInt(a.credits.number, 10) : null;
  const nb = b.credits?.number ? parseInt(b.credits.number, 10) : null;
  if (na === null && nb === null) return 0;
  if (na === null) return 1;
  if (nb === null) return -1;
  return na - nb;
});
// Client script reuses this template (with {n} swapped for the live count),
// same pattern as the events list's filter count.
const countTemplate = t(lang, 'songs.count', { n: '__N__' });
---

<Layout title={t(lang, 'songs.title')} lang={lang} path="songs/">
  <PageHeader title={t(lang, 'songs.title')} />

  <div class="flex flex-wrap items-center justify-between gap-2">
    <SpecialFilter label={t(lang, 'songs.includeSpecial')} />
    <p id="songs-count" class="text-muted-foreground text-sm" data-template={countTemplate}>
      {t(lang, 'songs.count', { n: songs.length })}
    </p>
  </div>

  <StatsTable>
    <Table id="songs-table" class="[&_td:first-child]:pl-4 [&_th:first-child]:pl-4 [&_td:last-child]:pr-4 [&_th:last-child]:pr-4">
      <TableHeader>
        <TableRow class="bg-muted/50">
          <TableHead data-sort-type="number">{t(lang, 'songs.numberShort')}</TableHead>
          <TableHead>{t(lang, 'songs.name')}</TableHead>
          <TableHead data-sort-type="date">{t(lang, 'songs.debut')}</TableHead>
          <TableHead data-sort-type="number">{t(lang, 'songs.plays')}</TableHead>
          <TableHead data-sort-type="number">{t(lang, 'songs.playRate')}</TableHead>
        </TableRow>
      </TableHeader>
      <TableBody>
        {
          sorted.map((song) => (
            <TableRow data-special={song.is_se || song.is_interlude ? '1' : '0'}>
              <TableCell class="text-muted-foreground tabular-nums" data-sort-value={song.credits?.number ?? ''}>
                {song.credits?.number ? formatTrackNumber(song.credits.number) : ''}
              </TableCell>
              <TableCell class="font-medium">
                <a href={`${base}/${lang}/songs/${urlSafe(song.id)}/`}>{songDisplayName(lang, song)}</a>
              </TableCell>
              <TableCell class="text-muted-foreground tabular-nums" data-sort-value={song.first_performed}>
                {song.first_performed}
              </TableCell>
              <TableCell class="tabular-nums" data-sort-value={song.plays}>{song.plays}</TableCell>
              <TableCell class="tabular-nums" data-sort-value={song.play_rate}>
                {Math.round(song.play_rate * 100)}%
              </TableCell>
            </TableRow>
          ))
        }
      </TableBody>
    </Table>
  </StatsTable>

  <script>
    import { initSortableTable } from '../../../lib/sortable-table';
    initSortableTable(document.getElementById('songs-table') as HTMLTableElement);

    const checkbox = document.getElementById('include-special') as HTMLInputElement;
    const rows = document.querySelectorAll<HTMLTableRowElement>('#songs-table tbody tr');
    const countEl = document.getElementById('songs-count')!;
    const template = countEl.dataset.template!;

    function apply() {
      let visible = 0;
      rows.forEach((row) => {
        const show = checkbox.checked || row.dataset.special === '0';
        row.hidden = !show;
        if (show) visible++;
      });
      countEl.textContent = template.replace('__N__', String(visible));
    }

    checkbox.addEventListener('change', apply);
  </script>
</Layout>
