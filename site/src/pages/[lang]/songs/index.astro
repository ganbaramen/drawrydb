---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import SpecialFilter from '../../../components/SpecialFilter.astro';
import ColumnPicker, { type Column } from '../../../components/ColumnPicker.astro';
import StatsTable from '../../../components/StatsTable.astro';
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@/components/ui/table';
import { songs, type Song } from '../../../lib/data';
import { formatTrackNumber, songDisplayName, urlSafe } from '../../../lib/format';
import { LOCALES, t, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const base = import.meta.env.BASE_URL;
// Debut order first (first_performed is ISO, so plain string comparison
// sorts correctly), then track number as a tiebreaker for songs debuted
// the same day — a song with no number (SE/Interlude) sorts after one
// that has it, same "blanks last" convention as the sortable columns
// below (see lib/sortable-table.ts). This is just the *default* order;
// every column here is still independently sortable by clicking it.
const sorted = songs.slice().sort((a, b) => {
  if (a.first_performed !== b.first_performed) {
    return a.first_performed < b.first_performed ? -1 : 1;
  }
  const na = a.credits?.number ? parseInt(a.credits.number, 10) : null;
  const nb = b.credits?.number ? parseInt(b.credits.number, 10) : null;
  if (na === null && nb === null) return 0;
  if (na === null) return 1;
  if (nb === null) return -1;
  return na - nb;
});

// The optional columns, in the order they appear to the right of the four
// fixed ones (#, name, debut, plays). Nearly every stat song_stats.csv
// carries is offered here rather than only the ones that fit comfortably —
// the whole point of the picker is that the reader decides which handful to
// look at, so a stat being narrow-interest is a reason to default it off,
// not to leave it out. `on` is the server-rendered default for a first-time
// reader; lib/column-picker.ts overrides it from localStorage after that.
//
// `shows` is the exception, deliberately left out: it differs from `plays`
// only when a song was played twice in one show, which is 2 songs of 23 and
// 3 shows of 152 (Dear,History at the debut show, Interlude twice over —
// those being two different interludes under one name). A column that reads
// identically on 21 of 23 rows is noise. It stays in song_stats.csv, and
// play_rate — which is built on it, not on plays — still reports it on a
// song's own page.
//
// `key` is the contract with the markup and with localStorage: it goes on
// both the <th> and every <td> as data-column, and is what gets persisted.
// Renaming one silently resets that column for everyone who had toggled it.
type StatColumn = Column & {
  sortType: 'number' | 'date';
  value: (song: Song) => string | number;
  text: (song: Song) => string;
};

const columns: StatColumn[] = [
  {
    key: 'play_rate',
    label: t(lang, 'songs.playRate'),
    on: true,
    sortType: 'number',
    value: (song) => song.play_rate,
    text: (song) => `${Math.round(song.play_rate * 100)}%`,
  },
  {
    key: 'opened',
    label: t(lang, 'songs.opened'),
    on: false,
    sortType: 'number',
    value: (song) => song.opened,
    text: (song) => String(song.opened),
  },
  {
    key: 'closed',
    label: t(lang, 'songs.closed'),
    on: false,
    sortType: 'number',
    value: (song) => song.closed,
    text: (song) => String(song.closed),
  },
  {
    key: 'last_performed',
    label: t(lang, 'songs.lastPerformedShort'),
    on: false,
    sortType: 'date',
    value: (song) => song.last_performed,
    text: (song) => song.last_performed,
  },
  {
    key: 'current_streak',
    label: t(lang, 'songs.streakShort'),
    on: false,
    sortType: 'number',
    value: (song) => song.current_streak,
    text: (song) => String(song.current_streak),
  },
  {
    key: 'longest_streak',
    label: t(lang, 'songs.longestStreakShort'),
    on: false,
    sortType: 'number',
    value: (song) => song.longest_streak,
    text: (song) => String(song.longest_streak),
  },
  {
    key: 'encores',
    label: t(lang, 'songs.encores'),
    on: false,
    sortType: 'number',
    value: (song) => song.encores,
    text: (song) => String(song.encores),
  },
];

// The menu shows each column's full label; the header cell shows a short one
// where the full name would widen the table for no gain (最初の曲 -> 最初).
const headings: Record<string, string> = {
  opened: t(lang, 'songs.openedShort'),
  closed: t(lang, 'songs.closedShort'),
};

// Client script reuses this template (with {n} swapped for the live count),
// same pattern as the events list's filter count.
const countTemplate = t(lang, 'songs.count', { n: '__N__' });
---

<Layout title={t(lang, 'songs.title')} lang={lang} path="songs/">
  <PageHeader title={t(lang, 'songs.title')} />

  {/* The checkbox and the column menu are both small muted controls, so they
      sit on opposite ends of the row rather than side by side, where they
      read as one pair of similar things. The menu is also a bordered chip,
      and being flush with the table's right edge marks it as acting on the
      table's shape rather than on which rows it holds. */}
  <div class="flex flex-wrap items-center justify-between gap-3">
    <SpecialFilter label={t(lang, 'songs.includeSpecial')} />
    <div class="flex items-center gap-3">
      <p id="songs-count" class="text-muted-foreground text-sm" data-template={countTemplate}>
        {t(lang, 'songs.count', { n: songs.length })}
      </p>
      <ColumnPicker
        label={t(lang, 'songs.columns')}
        columns={columns}
        storageKey="drawrydb:songs-columns"
      />
    </div>
  </div>

  <StatsTable>
    <Table id="songs-table">
      <TableHeader>
        <TableRow>
          <TableHead data-sort-type="number">{t(lang, 'songs.numberShort')}</TableHead>
          <TableHead>{t(lang, 'songs.name')}</TableHead>
          <TableHead data-sort-type="date">{t(lang, 'songs.debut')}</TableHead>
          <TableHead class="text-right" data-sort-type="number">{t(lang, 'songs.plays')}</TableHead>
          {
            columns.map((column) => (
              <TableHead
                class="text-right"
                data-sort-type={column.sortType}
                data-column={column.key}
                hidden={!column.on}
              >
                {headings[column.key] ?? column.label}
              </TableHead>
            ))
          }
        </TableRow>
      </TableHeader>
      <TableBody>
        {
          sorted.map((song) => (
            <TableRow data-special={song.is_se || song.is_interlude ? '1' : '0'}>
              <TableCell class="text-muted-foreground tabular-nums" data-sort-value={song.credits?.number ?? ''}>
                {song.credits?.number ? formatTrackNumber(song.credits.number) : ''}
              </TableCell>
              <TableCell class="font-medium">
                <a href={`${base}/${lang}/songs/${urlSafe(song.id)}/`}>{songDisplayName(lang, song)}</a>
              </TableCell>
              <TableCell class="text-muted-foreground tabular-nums" data-sort-value={song.first_performed}>
                {song.first_performed}
              </TableCell>
              <TableCell class="text-right tabular-nums" data-sort-value={song.plays}>{song.plays}</TableCell>
              {columns.map((column) => (
                <TableCell
                  class="text-muted-foreground text-right tabular-nums"
                  data-sort-value={column.value(song)}
                  data-column={column.key}
                  hidden={!column.on}
                >
                  {column.text(song)}
                </TableCell>
              ))}
            </TableRow>
          ))
        }
      </TableBody>
    </Table>
  </StatsTable>

  <script>
    import { initSortableTable } from '../../../lib/sortable-table';
    import { initColumnPicker } from '../../../lib/column-picker';

    const table = document.getElementById('songs-table') as HTMLTableElement;
    initSortableTable(table);
    initColumnPicker(document.querySelector('.column-picker') as HTMLElement, table);

    const checkbox = document.getElementById('include-special') as HTMLInputElement;
    const rows = document.querySelectorAll<HTMLTableRowElement>('#songs-table tbody tr');
    const countEl = document.getElementById('songs-count')!;
    const template = countEl.dataset.template!;

    function apply() {
      let visible = 0;
      rows.forEach((row) => {
        const show = checkbox.checked || row.dataset.special === '0';
        row.hidden = !show;
        if (show) visible++;
      });
      countEl.textContent = template.replace('__N__', String(visible));
    }

    checkbox.addEventListener('change', apply);

    // Run once on load, not only on change: a browser restoring the
    // checkbox's state (reload, back-forward cache) can hand us a page whose
    // control and rows disagree. The events index does the same for the same
    // reason.
    apply();
  </script>
</Layout>
