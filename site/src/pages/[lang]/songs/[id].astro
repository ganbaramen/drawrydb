---
import Layout from '../../../layouts/Layout.astro';
import CreditNames from '../../../components/CreditNames.astro';
import { songs, events, today, type Song } from '../../../lib/data';
import { autoLink, formatDate, formatTrackNumber, songDisplayName, songSubtitle, urlSafe } from '../../../lib/format';
import { LOCALES, t, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  // params.id must stay the raw name — Astro's route matcher compares
  // against the *decoded* request path, so a pre-encoded param here 404s.
  // Astro itself only percent-escapes structurally unsafe characters (like
  // "#") in the output path, leaving Japanese text and most punctuation
  // untouched; hrefs use the matching urlSafe() from lib/format.ts.
  return LOCALES.flatMap((lang) =>
    songs.map((song) => ({
      params: { lang, id: song.id },
      props: { song, lang },
    })),
  );
}

const { song, lang } = Astro.props as { song: Song; lang: Lang };
const base = import.meta.env.BASE_URL;
// Most recent first, matching the events list's ordering convention.
const performances = song.performances.slice().reverse();

// first_performed/last_performed are dates derived in the pipeline (see
// CLAUDE.md's song_stats section); find the matching performance to link
// to the actual event. A tie (two shows the same day) just takes the
// first match in performances' own order — which show gets linked barely
// matters here, both are "correct" for the date shown.
function eventFor(date: string) {
  const performance = song.performances.find((p) => p.date === date);
  return performance ? events.find((e) => e.id === performance.event_id) : undefined;
}
const debutEvent = eventFor(song.first_performed);
const lastEvent = eventFor(song.last_performed);
const credits = song.credits;

// Build-time "today" (see data.ts) — same static-site caveat as
// upcomingEvents(): accurate as of the last deploy, not the visit.
const daysSinceLast = Math.floor(
  (Date.parse(today) - Date.parse(song.last_performed)) / 86_400_000,
);

---

<Layout title={songDisplayName(lang, song)} lang={lang} path={`songs/${urlSafe(song.id)}/`}>
  <p><a href="../">{t(lang, 'songs.back')}</a></p>

  <h1>{songDisplayName(lang, song)}</h1>
  {songSubtitle(lang, song) && <p class="song-translation">{songSubtitle(lang, song)}</p>}

  {
    credits && (
      <>
      <h2>{t(lang, 'songs.credits')}</h2>
      <table class="meta-table">
        {credits.number && (
          <tr>
            <th>{t(lang, 'songs.number')}</th>
            <td>{formatTrackNumber(credits.number)}</td>
          </tr>
        )}
        {credits.lyrics && (
          <tr>
            <th>{t(lang, 'songs.lyrics')}</th>
            <td>
              <CreditNames value={credits.lyrics} lang={lang} />
            </td>
          </tr>
        )}
        {credits.composition && (
          <tr>
            <th>{t(lang, 'songs.composition')}</th>
            <td>
              <CreditNames value={credits.composition} lang={lang} />
            </td>
          </tr>
        )}
        {credits.arrangement && (
          <tr>
            <th>{t(lang, 'songs.arrangement')}</th>
            <td>
              <CreditNames value={credits.arrangement} lang={lang} />
            </td>
          </tr>
        )}
        {credits.choreography && (
          <tr>
            <th>{t(lang, 'songs.choreography')}</th>
            <td>
              <CreditNames value={credits.choreography} lang={lang} />
            </td>
          </tr>
        )}
        {credits.note && (
          <tr>
            <th>{t(lang, 'songs.note')}</th>
            <td>
              {autoLink(credits.note).map((chunk) =>
                chunk.url ? (
                  <a href={chunk.url} target="_blank" rel="noopener noreferrer">
                    {chunk.text}
                  </a>
                ) : (
                  chunk.text
                ),
              )}
            </td>
          </tr>
        )}
      </table>
      </>
    )
  }

  <h2>{t(lang, 'songs.stats')}</h2>
  <table class="meta-table">
    <tr>
      <th>{t(lang, 'songs.plays')}</th>
      <td>{t(lang, 'songs.playsCount', { n: song.plays })}</td>
    </tr>
    <tr>
      <th>{t(lang, 'songs.debut')}</th>
      <td>
        {song.first_performed}
        {debutEvent && (
          <>
            {' — '}
            <a href={`${base}/${lang}/events/${debutEvent.id}/`}>{debutEvent.title}</a>
          </>
        )}
      </td>
    </tr>
    <tr>
      <th>{t(lang, 'songs.lastPerformed')}</th>
      <td>
        {song.last_performed}
        {lastEvent && (
          <>
            {' — '}
            <a href={`${base}/${lang}/events/${lastEvent.id}/`}>{lastEvent.title}</a>
          </>
        )}
        {daysSinceLast > 0 && <span>（{t(lang, 'songs.daysAgo', { n: daysSinceLast })}）</span>}
      </td>
    </tr>
    <tr>
      <th>{t(lang, 'songs.playRate')}</th>
      <td>
        {t(lang, 'songs.playRateDetail', {
          pct: Math.round(song.play_rate * 100),
          shows: song.shows,
          total: song.shows_since_debut,
        })}
      </td>
    </tr>
    <tr>
      <th>{t(lang, 'songs.streak')}</th>
      <td>
        {t(lang, 'songs.streakDetail', {
          n: song.current_streak,
          longest: song.longest_streak,
        })}
      </td>
    </tr>
    {song.encores > 0 && (
      <tr>
        <th>{t(lang, 'songs.encores')}</th>
        <td>{t(lang, 'songs.playsCount', { n: song.encores })}</td>
      </tr>
    )}
  </table>

  <h2>{t(lang, 'songs.history')}</h2>
  <ul style="list-style:none; padding:0;">
    {
      performances.map((p) => {
        const event = events.find((e) => e.id === p.event_id);
        return (
          <li>
            <a class="event-card" href={`${base}/${lang}/events/${p.event_id}/`}>
              <div class="event-date">{formatDate(lang, p.date)}</div>
              <div class="event-title">
                {event?.title ?? p.venue}
                {p.is_encore && <span class="badge">{t(lang, 'badge.encore')}</span>}
              </div>
              {event?.title && <div class="event-venue">{p.venue}</div>}
              {p.note && <div class="song-note">{p.note}</div>}
            </a>
          </li>
        );
      })
    }
  </ul>
</Layout>
