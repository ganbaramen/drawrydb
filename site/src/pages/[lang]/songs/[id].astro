---
import Layout from '../../../layouts/Layout.astro';
import CreditNames from '../../../components/CreditNames.astro';
import EventCard from '../../../components/EventCard.astro';
import MetaRow from '../../../components/MetaRow.astro';
import MetaTable from '../../../components/MetaTable.astro';
import PageHeader from '../../../components/PageHeader.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import { Badge } from '@/components/ui/badge';
import { ItemGroup } from '@/components/ui/item';
import { songs, events, today, type Song } from '../../../lib/data';
import { autoLink, formatDate, formatTrackNumber, songDisplayName, songSubtitle, urlSafe } from '../../../lib/format';
import { LOCALES, t, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  // params.id must stay the raw name — Astro's route matcher compares
  // against the *decoded* request path, so a pre-encoded param here 404s.
  // Astro itself only percent-escapes structurally unsafe characters (like
  // "#") in the output path, leaving Japanese text and most punctuation
  // untouched; hrefs use the matching urlSafe() from lib/format.ts.
  return LOCALES.flatMap((lang) =>
    songs.map((song) => ({
      params: { lang, id: song.id },
      props: { song, lang },
    })),
  );
}

const { song, lang } = Astro.props as { song: Song; lang: Lang };
const base = import.meta.env.BASE_URL;
// Most recent first, matching the events list's ordering convention.
const performances = song.performances.slice().reverse();

// first_performed/last_performed are dates derived in the pipeline (see
// CLAUDE.md's song_stats section); find the matching performance to link
// to the actual event. A tie (two shows the same day) just takes the
// first match in performances' own order — which show gets linked barely
// matters here, both are "correct" for the date shown.
function eventFor(date: string) {
  const performance = song.performances.find((p) => p.date === date);
  return performance ? events.find((e) => e.id === performance.event_id) : undefined;
}
const debutEvent = eventFor(song.first_performed);
const lastEvent = eventFor(song.last_performed);
const credits = song.credits;

// Build-time "today" (see data.ts) — same static-site caveat as
// upcomingEvents(): accurate as of the last deploy, not the visit.
function daysSince(date: string): number {
  return Math.floor((Date.parse(today) - Date.parse(date)) / 86_400_000);
}
const daysSinceFirst = daysSince(song.first_performed);
const daysSinceLast = daysSince(song.last_performed);
// Full-width parens in Japanese, ASCII in English — same rule the event
// page's set-length aside uses.
const open = lang === 'ja' ? '（' : '(';
const close = lang === 'ja' ? '）' : ')';
---

<Layout title={songDisplayName(lang, song)} lang={lang} path={`songs/${urlSafe(song.id)}/`}>
  <PageHeader title={songDisplayName(lang, song)} backHref="../" backLabel={t(lang, 'songs.back')}>
    {
      songSubtitle(lang, song) && (
        <p slot="subtitle" class="text-muted-foreground text-base">
          {songSubtitle(lang, song)}
        </p>
      )
    }
  </PageHeader>

  {
    credits && (
      <section class="flex flex-col gap-2">
        <SectionHeading>{t(lang, 'songs.credits')}</SectionHeading>
        <MetaTable>
          {credits.number && (
            <MetaRow label={t(lang, 'songs.number')}>{formatTrackNumber(credits.number)}</MetaRow>
          )}
          {credits.lyrics && (
            <MetaRow label={t(lang, 'songs.lyrics')}>
              <CreditNames value={credits.lyrics} lang={lang} />
            </MetaRow>
          )}
          {credits.composition && (
            <MetaRow label={t(lang, 'songs.composition')}>
              <CreditNames value={credits.composition} lang={lang} />
            </MetaRow>
          )}
          {credits.arrangement && (
            <MetaRow label={t(lang, 'songs.arrangement')}>
              <CreditNames value={credits.arrangement} lang={lang} />
            </MetaRow>
          )}
          {credits.choreography && (
            <MetaRow label={t(lang, 'songs.choreography')}>
              <CreditNames value={credits.choreography} lang={lang} />
            </MetaRow>
          )}
          {credits.note && (
            <MetaRow label={t(lang, 'songs.note')}>
              {autoLink(credits.note).map((chunk) =>
                chunk.url ? (
                  <a href={chunk.url} target="_blank" rel="noopener noreferrer">
                    {chunk.text}
                  </a>
                ) : (
                  chunk.text
                ),
              )}
            </MetaRow>
          )}
        </MetaTable>
      </section>
    )
  }

  <section class="flex flex-col gap-2">
    <SectionHeading>{t(lang, 'songs.stats')}</SectionHeading>
    <MetaTable>
      <MetaRow label={t(lang, 'songs.plays')}>{t(lang, 'songs.playsCount', { n: song.plays })}</MetaRow>
      <MetaRow label={t(lang, 'songs.debut')}>
        {song.first_performed}
        {debutEvent && (
          <>
            {' — '}
            <a href={`${base}/${lang}/events/${debutEvent.id}/`}>{debutEvent.title}</a>
          </>
        )}
        {daysSinceFirst > 0 && (
          <span class="text-muted-foreground">
            {open}
            {t(lang, 'songs.daysAgo', { n: daysSinceFirst })}
            {close}
          </span>
        )}
      </MetaRow>
      <MetaRow label={t(lang, 'songs.lastPerformed')}>
        {song.last_performed}
        {lastEvent && (
          <>
            {' — '}
            <a href={`${base}/${lang}/events/${lastEvent.id}/`}>{lastEvent.title}</a>
          </>
        )}
        {daysSinceLast > 0 && (
          <span class="text-muted-foreground">
            {open}
            {t(lang, 'songs.daysAgo', { n: daysSinceLast })}
            {close}
          </span>
        )}
      </MetaRow>
      <MetaRow label={t(lang, 'songs.playRate')}>
        {t(lang, 'songs.playRateDetail', {
          pct: Math.round(song.play_rate * 100),
          shows: song.shows,
          total: song.shows_since_debut,
        })}
      </MetaRow>
      <MetaRow label={t(lang, 'songs.streak')}>
        {t(lang, 'songs.streakDetail', {
          n: song.current_streak,
          longest: song.longest_streak,
        })}
      </MetaRow>
      {song.encores > 0 && (
        <MetaRow label={t(lang, 'songs.encores')}>
          {t(lang, 'songs.playsCount', { n: song.encores })}
        </MetaRow>
      )}
    </MetaTable>
  </section>

  <section class="flex flex-col gap-3">
    <SectionHeading>{t(lang, 'songs.history')}</SectionHeading>
    <ItemGroup class="gap-2.5">
      {
        performances.map((p) => {
          const event = events.find((e) => e.id === p.event_id);
          return (
            <EventCard
              href={`${base}/${lang}/events/${p.event_id}/`}
              date={formatDate(lang, p.date)}
              title={event?.title ?? p.venue}
              venue={event?.title ? p.venue : undefined}
              note={p.note}
            >
              {p.is_encore && (
                <Badge slot="badge" variant="outline">
                  {t(lang, 'badge.encore')}
                </Badge>
              )}
            </EventCard>
          );
        })
      }
    </ItemGroup>
  </section>
</Layout>
