---
import Layout from '../../../layouts/Layout.astro';
import { venues } from '../../../lib/data';
import { urlSafe } from '../../../lib/format';
import { LOCALES, t, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const base = import.meta.env.BASE_URL;
const sorted = venues.slice().sort((a, b) => {
  if (a.shows !== b.shows) return b.shows - a.shows;
  if (a.first_played !== b.first_played) return a.first_played < b.first_played ? -1 : 1;
  return a.name < b.name ? -1 : a.name > b.name ? 1 : 0;
});
---

<Layout title={t(lang, 'venues.title')} lang={lang} path="venues/">
  <h1>{t(lang, 'venues.title')}</h1>
  <p>{t(lang, 'venues.count', { n: venues.length })}</p>
  <table class="stats-table" id="venues-table">
    <thead>
      <tr>
        <th>{t(lang, 'venues.name')}</th>
        <th data-sort-type="number">{t(lang, 'venues.shows')}</th>
        <th data-sort-type="date">{t(lang, 'venues.firstPlayed')}</th>
        <th data-sort-type="date">{t(lang, 'venues.lastPlayed')}</th>
      </tr>
    </thead>
    <tbody>
      {
        sorted.map((venue) => (
          <tr>
            <td>
              <a href={`${base}/${lang}/venues/${urlSafe(venue.id)}/`}>{venue.name}</a>
            </td>
            <td data-sort-value={venue.shows}>{venue.shows}</td>
            <td data-sort-value={venue.first_played}>{venue.first_played}</td>
            <td data-sort-value={venue.last_played}>{venue.last_played}</td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <script>
    import { initSortableTable } from '../../../lib/sortable-table';
    initSortableTable(document.getElementById('venues-table') as HTMLTableElement);
  </script>
</Layout>
