---
import Layout from '../../../layouts/Layout.astro';
import EventCard from '../../../components/EventCard.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { ItemGroup } from '@/components/ui/item';
import { venues } from '../../../lib/data';
import { urlSafe } from '../../../lib/format';
import { LOCALES, t, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const base = import.meta.env.BASE_URL;
const sorted = venues.slice().sort((a, b) => {
  if (a.shows !== b.shows) return b.shows - a.shows;
  if (a.first_played !== b.first_played) return a.first_played < b.first_played ? -1 : 1;
  return a.name < b.name ? -1 : a.name > b.name ? 1 : 0;
});
---

<Layout title={t(lang, 'venues.title')} lang={lang} path="venues/">
  <PageHeader title={t(lang, 'venues.title')} />
  <p class="text-muted-foreground -mt-2 text-sm">{t(lang, 'venues.count', { n: venues.length })}</p>

  <ItemGroup class="gap-2">
    {
      sorted.map((venue) => (
        <EventCard
          href={`${base}/${lang}/venues/${urlSafe(venue.id)}/`}
          title={venue.name}
          class="items-center"
        >
          <span slot="trailing" class="text-muted-foreground shrink-0 text-sm whitespace-nowrap">
            {t(lang, 'venues.showsCount', { n: venue.shows })}
          </span>
        </EventCard>
      ))
    }
  </ItemGroup>
</Layout>
