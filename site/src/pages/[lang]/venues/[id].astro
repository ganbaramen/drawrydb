---
import Layout from '../../../layouts/Layout.astro';
import EventCard from '../../../components/EventCard.astro';
import MetaRow from '../../../components/MetaRow.astro';
import MetaTable from '../../../components/MetaTable.astro';
import PageHeader from '../../../components/PageHeader.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import { ItemGroup } from '@/components/ui/item';
import { venues, getEvent, today, type Venue } from '../../../lib/data';
import { daysSince, formatDate, parenthesize, urlSafe } from '../../../lib/format';
import { LOCALES, t, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  // See songs/[id].astro for why params.id stays the raw name.
  return LOCALES.flatMap((lang) =>
    venues.map((venue) => ({
      params: { lang, id: venue.id },
      props: { venue, lang },
    })),
  );
}

const { venue, lang } = Astro.props as { venue: Venue; lang: Lang };
const base = import.meta.env.BASE_URL;
// Most recent first, matching the events list's ordering convention.
const eventIds = venue.event_ids.slice().reverse();

// first_played/last_played are dates derived in the pipeline (see
// CLAUDE.md's venue_stats section); find the matching event among this
// venue's own shows to link to it. See songs/[id].astro's eventFor() for
// why a same-day tie just takes the first match.
function eventFor(date: string) {
  const id = venue.event_ids.find((eventId) => getEvent(eventId)?.date === date);
  return id ? getEvent(id) : undefined;
}
const firstEvent = eventFor(venue.first_played);
const lastEvent = eventFor(venue.last_played);

// Build-time "today" (see data.ts) — the count is accurate as of the last
// deploy, not the visit. Same asides the song page's debut/last rows carry.
const daysSinceFirst = daysSince(today, venue.first_played);
const daysSinceLast = daysSince(today, venue.last_played);
---

<Layout title={venue.name} lang={lang} path={`venues/${urlSafe(venue.id)}/`}>
  <PageHeader title={venue.name} backHref="../" backLabel={t(lang, 'venues.back')} />

  <MetaTable>
    {venue.address && <MetaRow label={t(lang, 'venues.address')}>{venue.address}</MetaRow>}
    {venue.capacity && <MetaRow label={t(lang, 'venues.capacity')}>{venue.capacity}</MetaRow>}
    <MetaRow label={t(lang, 'venues.shows')}>{t(lang, 'venues.showsCount', { n: venue.shows })}</MetaRow>
    <MetaRow label={t(lang, 'venues.firstPlayed')}>
      {formatDate(lang, venue.first_played)}
      {firstEvent && (
        <>
          {' — '}
          <a href={`${base}/${lang}/events/${firstEvent.id}/`}>{firstEvent.title}</a>
        </>
      )}
      {daysSinceFirst > 0 && (
        <span class="text-muted-foreground">
          {parenthesize(lang, t(lang, 'common.daysAgo', { n: daysSinceFirst }))}
        </span>
      )}
    </MetaRow>
    <MetaRow label={t(lang, 'venues.lastPlayed')}>
      {formatDate(lang, venue.last_played)}
      {lastEvent && (
        <>
          {' — '}
          <a href={`${base}/${lang}/events/${lastEvent.id}/`}>{lastEvent.title}</a>
        </>
      )}
      {daysSinceLast > 0 && (
        <span class="text-muted-foreground">
          {parenthesize(lang, t(lang, 'common.daysAgo', { n: daysSinceLast }))}
        </span>
      )}
    </MetaRow>
  </MetaTable>

  <section class="flex flex-col gap-3">
    <SectionHeading>{t(lang, 'venues.history')}</SectionHeading>
    <ItemGroup class="gap-2.5">
      {
        eventIds.map((id) => {
          const event = getEvent(id);
          if (!event) return null;
          return (
            <EventCard
              href={`${base}/${lang}/events/${id}/`}
              date={formatDate(lang, event.date)}
              title={event.title}
            />
          );
        })
      }
    </ItemGroup>
  </section>
</Layout>
