---
import Layout from '../../../layouts/Layout.astro';
import { venues, getEvent, type Venue } from '../../../lib/data';
import { formatDate, urlSafe } from '../../../lib/format';
import { LOCALES, t, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  // See songs/[id].astro for why params.id stays the raw name.
  return LOCALES.flatMap((lang) =>
    venues.map((venue) => ({
      params: { lang, id: venue.id },
      props: { venue, lang },
    })),
  );
}

const { venue, lang } = Astro.props as { venue: Venue; lang: Lang };
const base = import.meta.env.BASE_URL;
// Most recent first, matching the events list's ordering convention.
const eventIds = venue.event_ids.slice().reverse();

// first_played/last_played are dates derived in the pipeline (see
// CLAUDE.md's venue_stats section); find the matching event among this
// venue's own shows to link to it. See songs/[id].astro's eventFor() for
// why a same-day tie just takes the first match.
function eventFor(date: string) {
  const id = venue.event_ids.find((eventId) => getEvent(eventId)?.date === date);
  return id ? getEvent(id) : undefined;
}
const firstEvent = eventFor(venue.first_played);
const lastEvent = eventFor(venue.last_played);
---

<Layout title={venue.name} lang={lang} path={`venues/${urlSafe(venue.id)}/`}>
  <p><a href="../">{t(lang, 'venues.back')}</a></p>

  <h1>{venue.name}</h1>

  <table class="meta-table">
    {venue.address && (
      <tr>
        <th>{t(lang, 'venues.address')}</th>
        <td>{venue.address}</td>
      </tr>
    )}
    {venue.capacity && (
      <tr>
        <th>{t(lang, 'venues.capacity')}</th>
        <td>{venue.capacity}</td>
      </tr>
    )}
    <tr>
      <th>{t(lang, 'venues.shows')}</th>
      <td>{t(lang, 'venues.showsCount', { n: venue.shows })}</td>
    </tr>
    <tr>
      <th>{t(lang, 'venues.firstPlayed')}</th>
      <td>
        {venue.first_played}
        {firstEvent && (
          <>
            {' — '}
            <a href={`${base}/${lang}/events/${firstEvent.id}/`}>{firstEvent.title}</a>
          </>
        )}
      </td>
    </tr>
    <tr>
      <th>{t(lang, 'venues.lastPlayed')}</th>
      <td>
        {venue.last_played}
        {lastEvent && (
          <>
            {' — '}
            <a href={`${base}/${lang}/events/${lastEvent.id}/`}>{lastEvent.title}</a>
          </>
        )}
      </td>
    </tr>
  </table>

  <h2>{t(lang, 'venues.history')}</h2>
  <ul style="list-style:none; padding:0;">
    {
      eventIds.map((id) => {
        const event = getEvent(id);
        if (!event) return null;
        return (
          <li>
            <a class="event-card" href={`${base}/${lang}/events/${id}/`}>
              <div class="event-date">{formatDate(lang, event.date)}</div>
              <div class="event-title">{event.title}</div>
            </a>
          </li>
        );
      })
    }
  </ul>
</Layout>
